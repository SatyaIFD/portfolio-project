---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Satyajit — MLOps, Cloud Architecture & DevSecOps Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/Favi2.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      // Apply theme before HTML renders to prevent flash of wrong theme
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="min-h-screen bg-[#F4F2EC] text-[#1E252B] antialiased transition-colors duration-300 dark:bg-[#0F1115] dark:text-[#EAE6DF] selection:bg-[#003399]/15 selection:text-[#003399] dark:selection:bg-[#5B8DEF]/20 dark:selection:text-[#5B8DEF]">
    
    <!-- Navigation Header -->
    <header class="sticky top-0 z-30 border-b border-[#E0DCD3] bg-[#F4F2EC]/85 backdrop-blur-md dark:border-[#1E252B] dark:bg-[#0F1115]/85">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80">
          <img src="/Favi2.svg" alt="VD Monogram" class="h-7 w-7" />
          <img src="/vraidaten-logo.svg" alt="VraiDaten" class="h-5 w-auto dark:brightness-150 dark:contrast-125" />
        </a>

        <nav class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-medium">
          <a href="/" class="hover:text-brand-accent-light dark:hover:text-brand-accent-dark transition-colors">Home</a>
          <a href="/projects" class="hover:text-brand-accent-light dark:hover:text-brand-accent-dark transition-colors">Projects</a>
          <a href="/logbook" class="hover:text-brand-accent-light dark:hover:text-brand-accent-dark transition-colors">Logbook</a>
          <a href="/contact" class="hover:text-brand-accent-light dark:hover:text-brand-accent-dark transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-4">
          <!-- Theme Toggle Button -->
          <button id="theme-toggle" type="button" class="rounded-md p-1.5 hover:bg-[#E0DCD3] dark:hover:bg-[#1E252B] transition-colors" aria-label="Toggle Dark Mode">
            <svg id="theme-toggle-dark-icon" class="hidden h-4 w-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="theme-toggle-light-icon" class="hidden h-4 w-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <slot />
    </main>

    <footer class="mt-20 border-t border-[#E0DCD3] bg-[#F4F2EC] py-8 text-center text-[11px] text-[#5C656D] dark:border-[#1E252B] dark:bg-[#0F1115] dark:text-[#8B949E]">
      <div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-3 sm:flex-row px-4 sm:px-6">
        <p>&copy; {new Date().getFullYear()} Satyajit. Built with Astro 7 & Cloudflare Workers.</p>
        <p class="font-mono">Open to Collaborative Roles (Domestic/EOR/B2B)</p>
      </div>
    </footer>

    <script>
      const themeToggleDarkIcon = document.getElementById("theme-toggle-dark-icon");
      const themeToggleLightIcon = document.getElementById("theme-toggle-light-icon");
      const themeToggleBtn = document.getElementById("theme-toggle");

      if (localStorage.getItem("theme") === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        themeToggleLightIcon?.classList.remove("hidden");
      } else {
        themeToggleDarkIcon?.classList.remove("hidden");
      }

      themeToggleBtn?.addEventListener("click", () => {
        themeToggleDarkIcon?.classList.toggle("hidden");
        themeToggleLightIcon?.classList.toggle("hidden");
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.classList.add("dark");
          localStorage.setItem("theme", "dark");
        } else {
          document.documentElement.classList.remove("dark");
          localStorage.setItem("theme", "light");
        }
      });
    </script>
  </body>
</html>
