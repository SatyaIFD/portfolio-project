---
import Layout from "../layouts/Layout.astro";

const tcsExperience = [
  {
    role: "Senior Associate – Information Process Enabler",
    project: "UK National Employment Savings Trust (NEST) Pension Administration",
    highlights: [
      "Validated and processed employer and employee pension contributions, transfers, withdrawals, and fund allocations.",
      "Investigated operational errors, identified data discrepancies, and performed validation and reconciliation within defined turnaround times (TAT).",
      "Ensured strict compliance with GDPR data privacy requirements and verified supporting authorization documentation.",
      "Collaborated with the Robotic Process Automation (RPA) team by explaining existing business workflows and documenting step-by-step transaction procedures.",
    ],
  },
  {
    role: "Process Associate",
    project: "Bank of America & US Healthcare Operations",
    highlights: [
      "Reviewed, validated, and evaluated US healthcare claims and Explanation of Benefits (EOBs) against policy guidelines.",
      "Worked on manual-to-digital validation of medical billing data while maintaining strict HIPAA privacy compliance.",
      "Performed quality assurance checks and supported new joiners post-training to resolve workflow queries.",
    ],
  },
];

const learningMilestones = [
  {
    date: "17 Nov 2026",
    title: "Linux Essentials Badge",
    issuer: "Cisco Networking Academy",
    note: "Formal milestone in Linux command-line operations and operating system fundamentals.",
  },
  {
    date: "Target: Dec 2026",
    title: "Google Cloud Professional ML Engineer (Studying)",
    issuer: "Google Cloud",
    note: "Currently building conceptual and practical understanding prior to attempting the exam.",
  },
  {
    date: "Dec 2024 – Present",
    title: "First-Principles Technical Upskilling Break",
    issuer: "Independent Study & Practical Implementation",
    note: "Revisited math & statistics (Khan Academy, StatQuest, Paul's Online Math Notes) and transitioned toward Cloud Engineering & MLOps.",
  },
  {
    date: "2022 – 2023",
    title: "Machine Learning with Python & Master of Data Science Bootcamp",
    issuer: "Cognitive Class (July 2022) & Simplilearn",
    note: "Built foundational knowledge in Python, data analysis, and machine learning concepts.",
  },
];

const currentFocusAreas = [
  {
    area: "Programming & Tooling",
    items: ["Python scripting & modern packaging", "Astral's uv package & project manager", "Git version control & automated testing (pytest)"],
  },
  {
    area: "OS, Cloud & Infrastructure",
    items: ["Linux CLI & system administration", "Google Cloud Platform (IAM, resource management, logging)", "Networking fundamentals & troubleshooting"],
  },
  {
    area: "Automation & MLOps Direction",
    items: ["CI/CD concepts & GitHub Actions pipelines", "Docker & Infrastructure as Code fundamentals", "ML model deployment, serving, pipelines & monitoring"],
  },
];
---

<Layout title="Satyajit Chakraborty | Business Operations to Cloud Engineering & MLOps">
  <!-- Hero / Professional Summary -->
  <section class="py-6 md:py-10 space-y-6">
    <div class="inline-flex items-center gap-2 rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-3 py-1 text-xs font-mono text-brand-accent-light dark:text-brand-accent-dark">
      <span>Career Transition · 9 Yrs 5 Mos at TCS BPS → Cloud Engineering &amp; MLOps</span>
    </div>

    <div class="space-y-4 max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-brand-ink dark:text-brand-cream leading-tight">
        Satyajit Chakraborty <br />
        <span class="text-xl md:text-2xl font-semibold text-brand-accent-light dark:text-brand-accent-dark">
          Operational Discipline Meets Cloud &amp; MLOps Engineering
        </span>
      </h1>

      <p class="text-sm md:text-base text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        I am a business operations professional with <strong class="font-semibold text-brand-ink dark:text-brand-cream">9 years and 5 months of experience at Tata Consultancy Services (TCS BPS)</strong> across financial services, UK pension administration (NEST), US healthcare operations, data validation, and quality assurance. After collaborating with RPA automation teams in 2021 and taking a dedicated technical upskilling break in December 2024, I am transitioning into a <strong class="font-semibold text-brand-ink dark:text-brand-cream">junior-level Cloud Engineering, Cloud ML, or MLOps role</strong> where I can combine my operational reliability with developing engineering skills inside a collaborative team.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/projects"
          class="inline-flex items-center justify-center rounded-md bg-brand-accent-light dark:bg-brand-accent-dark px-4 py-2 text-xs sm:text-sm font-semibold text-[#E7E2D6] dark:text-brand-slate transition-transform hover:scale-[1.02]"
        >
          Current &amp; Planned Projects
        </a>
        <button
          type="button"
          data-open-ai-chat
          class="inline-flex items-center justify-center rounded-md border border-brand-forest-light/50 dark:border-brand-forest-dark/50 bg-brand-surface dark:bg-brand-slate-surface px-4 py-2 text-xs sm:text-sm font-semibold text-brand-forest-light dark:text-brand-forest-dark hover:border-brand-forest-light cursor-pointer"
        >
          Ask Edge AI Assistant
        </button>
        <a
          href="https://www.linkedin.com/in/satyajitchakraborty91"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-4 py-2 text-xs sm:text-sm font-medium text-brand-ink dark:text-brand-cream hover:border-brand-accent-light transition-colors"
        >
          LinkedIn Profile
        </a>
      </div>
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-8" />

  <!-- Section 1: Professional Experience at TCS -->
  <section class="space-y-6">
    <div class="space-y-2">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        01 · Enterprise Foundation (July 2015 – December 2024)
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Professional Experience — Tata Consultancy Services (TCS BPS)
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        Academic Qualification: <strong class="font-semibold text-brand-ink dark:text-brand-cream">B.Com (Honours), Accounting and Finance — University of Calcutta</strong>. Across nearly a decade at TCS, my work centered on data integrity, root-cause discrepancy investigation, regulatory compliance (GDPR &amp; HIPAA), and process documentation.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {tcsExperience.map((exp) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 space-y-3">
          <div>
            <h3 class="text-base font-bold text-brand-ink dark:text-brand-cream">{exp.role}</h3>
            <p class="text-xs font-mono text-brand-accent-light dark:text-brand-accent-dark mt-0.5">{exp.project}</p>
          </div>
          <ul class="space-y-2 text-xs text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed list-disc pl-4">
            {exp.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-10" />

  <!-- Section 2: Journey into Tech & Learning Milestones -->
  <section class="space-y-6">
    <div class="space-y-2">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-forest-light dark:text-brand-forest-dark">
        02 · Transition Journey &amp; Structured Upskilling
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        From RPA Process Mapping to Cloud Engineering &amp; MLOps
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        My interest in technology began in 2021 while explaining operational workflows to the RPA team at TCS and seeing bots clear high-volume queues. In December 2024, I took a dedicated career break to build my technical foundations from first principles rather than jumping superficially between tools.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {learningMilestones.map((m) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-5 space-y-2">
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono text-[11px] font-semibold text-brand-forest-light dark:text-brand-forest-dark">{m.date}</span>
            <span class="font-mono text-[10px] text-brand-ink-muted dark:text-brand-cream-muted">{m.issuer}</span>
          </div>
          <h3 class="text-sm font-bold text-brand-ink dark:text-brand-cream">{m.title}</h3>
          <p class="text-xs text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">{m.note}</p>
        </div>
      ))}
    </div>

    <div class="grid gap-5 md:grid-cols-3 pt-2">
      {currentFocusAreas.map((group) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-5 space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-wider font-semibold text-brand-accent-light dark:text-brand-accent-dark">
            {group.area}
          </h3>
          <ul class="space-y-1.5 text-xs text-brand-ink-muted dark:text-brand-cream-muted list-disc pl-4">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-10" />

  <!-- Section 3: Honest Technical Comfort Level & Learning Philosophy -->
  <section class="space-y-6">
    <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 sm:p-8 space-y-4">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        03 · Transparency &amp; Engineering Mindset
      </p>
      <h2 class="text-xl font-bold text-brand-ink dark:text-brand-cream">
        Honest Technical Comfort Level
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        I consider myself to be in the <strong class="font-semibold text-brand-ink dark:text-brand-cream">technical transition and skill-development stage</strong> rather than an experienced Cloud or MLOps engineer. I do not claim deep, independent production-level expertise across every tool listed. I understand that <em>knowing a concept</em>, <em>implementing it independently</em>, and <em>maintaining it in a production environment</em> are three distinct levels of capability—and my goal is to progressively develop all three.
      </p>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        When exploring new tools—such as incorporating <strong class="font-semibold text-brand-ink dark:text-brand-cream">Astral&apos;s uv</strong> into my Python workflow or reading about computational efficiency research like <strong class="font-semibold text-brand-ink dark:text-brand-cream">Stanford&apos;s NCM project</strong>—my focus is on understanding <em>why</em> a technology exists, what problem it solves, and how to verify it. I use AI assistants transparently as learning and development force-multipliers, always paired with step-by-step verification, documentation, and automated checks.
      </p>
    </div>
  </section>
</Layout>
