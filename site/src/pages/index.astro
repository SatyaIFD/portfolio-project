---
import Layout from "../layouts/Layout.astro";

const starterPrompts = [
  "What Cloudflare services power this portfolio's infrastructure?",
  "How does ADR 006 protect the 10,000 daily free Neurons budget?",
  "How are credentials managed securely without plaintext .env files?",
  "What DevSecOps gates run in CI before code merges to main?",
];
---

<Layout title="Satyajit | MLOps & Cloud Architecture">
  <!-- Hero / Intro Section -->
  <section class="py-12 md:py-20">
    <div class="space-y-6 max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-brand-ink dark:text-brand-cream leading-tight">
        Satyajit. <br class="hidden sm:block" />
        <span class="text-brand-accent-light dark:text-brand-accent-dark">MLOps & Cloud Architecture.</span>
      </h1>
      
      <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        I engineer verifiable, cost-bounded cloud infrastructure and machine learning pipelines. Currently finalizing the <strong class="font-semibold text-brand-ink dark:text-brand-cream">Google Cloud Professional ML Engineer</strong> certification, I am seeking domestic, EOR, or B2B contracts as an integrated collaborative team member—not a detached consultant.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a href="#rag-studio" class="inline-flex items-center justify-center rounded-md bg-brand-ink dark:bg-brand-cream px-5 py-2.5 text-sm font-semibold text-brand-paper dark:text-brand-slate transition-transform hover:scale-[1.02]">
          Query My Architecture
        </a>
        <a href="/projects" class="inline-flex items-center justify-center rounded-md border border-slate-300 dark:border-slate-700 bg-transparent px-5 py-2.5 text-sm font-medium text-brand-ink dark:text-brand-cream hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          View Projects
        </a>
      </div>
    </div>
  </section>

  <hr class="border-t border-[#E0DCD3] dark:border-[#1E252B] my-12" />

  <!-- RAG Studio Section -->
  <section id="rag-studio" class="scroll-mt-24">
    <div class="mb-8 space-y-2">
      <h2 class="text-2xl font-bold tracking-tight">Ask Edge AI</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        I use AI as an engineering force-multiplier. This RAG assistant (<code class="font-mono text-brand-accent-light dark:text-brand-accent-dark text-xs">@cf/ibm-granite/granite-4.0-h-micro</code>) is grounded strictly in my verified documentation (ADRs 001–009) via Cloudflare Vectorize.
      </p>
    </div>

    <!-- Chat Console -->
    <div class="rounded-xl border border-[#E0DCD3] dark:border-[#1E252B] bg-white dark:bg-[#13151A] shadow-sm overflow-hidden flex flex-col h-[500px]">
      
      <!-- Transparency Header -->
      <div class="border-b border-[#E0DCD3] dark:border-[#1E252B] bg-slate-50 dark:bg-[#0F1115] px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[11px] font-mono font-medium uppercase tracking-wider text-slate-600 dark:text-slate-400">
            Live Edge RAG Session
          </span>
        </div>
        <span class="text-[10px] text-slate-500 dark:text-slate-500">
          EU AI Act Art. 50 Disclosed · GDPR Zero-PII
        </span>
      </div>

      <!-- Scrollable Message Area -->
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-transparent">
        <div class="flex justify-start">
          <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-slate-100 dark:bg-[#1E252B] px-4 py-3 text-sm text-slate-800 dark:text-slate-200 leading-relaxed">
            Welcome. You can click a starter prompt below or ask any question about Satyajit's MLOps pipeline, CI/CD security gates, or infrastructure decisions.
          </div>
        </div>
      </div>

      <!-- Input Area & Starter Prompts -->
      <div class="border-t border-[#E0DCD3] dark:border-[#1E252B] bg-slate-50 dark:bg-[#0F1115] p-4">
        
        <div class="mb-3 flex flex-wrap gap-2">
          {starterPrompts.map((prompt) => (
            <button
              type="button"
              data-starter-prompt={prompt}
              class="rounded-md border border-[#E0DCD3] dark:border-[#1E252B] bg-white dark:bg-[#13151A] px-2.5 py-1 text-left text-[11px] text-slate-600 dark:text-slate-400 transition hover:border-brand-accent-light dark:hover:border-brand-accent-dark hover:text-brand-ink dark:hover:text-brand-cream"
            >
              {prompt}
            </button>
          ))}
        </div>

        <form id="chat-form" class="relative">
          <label for="chat-input" class="sr-only">Ask a question</label>
          <textarea
            id="chat-input"
            name="prompt"
            rows="2"
            maxlength="500"
            required
            placeholder="Ask about the architecture, security gates, or cost controls..."
            class="w-full resize-none rounded-lg border border-[#E0DCD3] dark:border-[#1E252B] bg-white dark:bg-[#13151A] px-3.5 py-2.5 text-sm text-brand-ink dark:text-brand-cream placeholder-slate-400 dark:placeholder-slate-500 focus:border-brand-accent-light dark:focus:border-brand-accent-dark focus:ring-1 focus:ring-brand-accent-light dark:focus:ring-brand-accent-dark focus:outline-none"
          ></textarea>
          
          <div class="mt-2 flex items-center justify-between">
            <span id="char-count" class="font-mono text-[10px] text-slate-500">0 / 500</span>
            <button
              id="chat-submit"
              type="submit"
              class="rounded-md bg-brand-ink dark:bg-brand-cream px-4 py-1.5 text-xs font-semibold text-brand-paper dark:text-brand-slate transition-transform hover:scale-[1.02] disabled:opacity-50"
            >
              Send
            </button>
          </div>
        </form>
      </div>
      
    </div>
  </section>

  <script src="../scripts/chat-client.ts"></script>
</Layout>
