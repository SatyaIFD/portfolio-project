---
import Layout from "../layouts/Layout.astro";

const adrCount = Object.keys(import.meta.glob("../../../docs/projects/*/decisions/*.md")).length;
const hurdleCount = Object.keys(import.meta.glob("../../../docs/projects/*/hurdles/*.md")).length;

interface CertificateAction {
  label: string;
  src: string;
  title: string;
}

interface AwardItem {
  title: string;
  detail: string;
  certificates: CertificateAction[];
}

interface SkillItem {
  text: string;
  verifyUrl?: string;
  verifyLabel?: string;
}

interface SkillTier {
  tier: string;
  meaning: string;
  badgeClass: string;
  items: SkillItem[];
}

const tcsExperience = [
  {
    role: "Senior Associate – Information Process Enabler",
    project: "UK National Employment Savings Trust (NEST) Pension Administration",
    highlights: [
      "Validated and processed employer and employee pension contributions, pension transfers, withdrawals, and related account updates.",
      "Ensured accurate allocation of funds into members' pension accounts and verified supporting documentation before proceeding with transactions.",
      "Investigated operational errors, identified data discrepancies, and performed validation and reconciliation within defined turnaround times (TAT) while maintaining process accuracy and quality.",
      "Communicated with customers regarding outstanding information and documentation, using predefined email templates and coordinating with internal teams to obtain and validate authorisation documents before processing transactions.",
      "Ensured strict compliance with GDPR and maintained data confidentiality.",
      "Collaborated with the Robotic Process Automation (RPA) team by explaining existing business workflows, documenting process steps, and sharing operational knowledge on how transactions were handled.",
    ],
  },
  {
    role: "Process Associate",
    project: "Bank of America & US Healthcare Operations",
    highlights: [
      "Handled healthcare claims, member services, and support activities, reviewing, validating, and evaluating claims according to applicable US healthcare policies.",
      "Worked on manual-to-digital processing and validation of medical billing data and Explanation of Benefits (EOBs).",
      "Performed quality checks, identified discrepancies in processed information, and adhered strictly to HIPAA privacy requirements.",
      "Supported new joiners after their initial training across both projects, helping them understand workflows, resolve process-related queries, and become familiar with operational procedures.",
    ],
  },
];

const tcsAwards: AwardItem[] = [
  {
    title: "BPS Star Performance Award",
    detail: "Recognised for consistent operational excellence, process accuracy, and quality delivery.",
    certificates: [
      {
        label: "View Certificate",
        src: "/certificates/bps-star-performance.webp",
        title: "TCS BPS Star Performance Award",
      },
    ],
  },
  {
    title: "Service and Commitment Award",
    detail:
      "Honoured for long-term dedication and tenure at TCS—received at 3 years (post 1-year training period) and at the 5th year.",
    certificates: [
      {
        label: "View 3-Yr Award",
        src: "/certificates/service-and-commitment3.webp",
        title: "TCS Service & Commitment Award (3 Years Post-Training)",
      },
      {
        label: "View 5-Yr Award",
        src: "/certificates/service-and-commitment5.webp",
        title: "TCS Service & Commitment Award (5th Year)",
      },
    ],
  },
  {
    title: "Xcelerate Warrior Award",
    detail: "Awarded for proactive upskilling and commitment to continuous professional learning.",
    certificates: [
      {
        label: "View Certificate",
        src: "/certificates/xcelerate-warrior.webp",
        title: "TCS Xcelerate Warrior Award",
      },
    ],
  },
  {
    title: "Internal Dedication Award",
    detail: "Project recognition received on the Bank of America HIPAA healthcare operations engagement.",
    certificates: [],
  },
];

const skillTiers: SkillTier[] = [
  {
    tier: "Tier 1 · Completed / Demonstrated",
    meaning: "Skills used in completed coursework, verified badges, or implemented in this repository",
    badgeClass: "text-brand-forest-light dark:text-brand-forest-dark",
    items: [
      {
        text: "Linux fundamentals & CLI operations (Cisco Networking Academy Linux Essentials, 17 Nov 2026)",
        verifyUrl: "https://www.credly.com/badges/0713a5e5-070f-4150-8e08-a7e825ae60b6",
        verifyLabel: "Verify on Credly ↗",
      },
      {
        text: "IBM Machine Learning with Python (Cognitive Class, July 2022)",
        verifyUrl: "https://courses.cognitiveclass.ai/certificates/78b296a49bd24d0e9e837efef775bca1",
        verifyLabel: "Verify Certificate ↗",
      },
      {
        text: "Master's Program for Data Scientist (Simplilearn)",
        verifyUrl: "https://success.simplilearn.com/2568c26f-3d1b-4692-b9cd-87d2fd2bf7cc#acc.RwOUGiWj",
        verifyLabel: "Verify Certificate ↗",
      },
      { text: "Python scripting, Markdown processing & automated unit testing (pytest)" },
      { text: "Modern Python project & dependency management with Astral's uv" },
      { text: "Git version control, branching & GitHub pull request workflows" },
      { text: "Automated code quality & security hygiene (ruff, mypy, bandit, pip-audit, detect-secrets, OS Keyring libsecret)" },
      { text: "First-principles Mathematics & Statistics refresher (Khan Academy, StatQuest, Paul's Online Math Notes)" },
    ],
  },
  {
    tier: "Tier 2 · Currently Practising",
    meaning: "Technologies I am actively using, studying, and experimenting with in current work",
    badgeClass: "text-brand-accent-light dark:text-brand-accent-dark",
    items: [
      { text: "Google Cloud Platform (GCP) core infrastructure, resource management, IAM, monitoring & logging" },
      { text: "Google Cloud Professional Machine Learning Engineer study track (Target: December 2026; not yet attempted)" },
      { text: "Application deployment, DNS configuration & Cloudflare Workers / Vectorize / Workers AI (vraidaten.com)" },
      { text: "CI/CD pipeline concepts and GitHub Actions automation" },
      { text: "Troubleshooting build, networking, and runtime configuration issues" },
    ],
  },
  {
    tier: "Tier 3 · Planned Learning",
    meaning: "Technologies I intend to explore next for my upcoming Google Cloud end-to-end project",
    badgeClass: "text-brand-ink-muted dark:text-brand-cream-muted",
    items: [
      { text: "Docker and containerization workflows" },
      { text: "Infrastructure as Code (IaC) fundamentals" },
      { text: "Machine learning model deployment, model serving & inference on Google Cloud" },
      { text: "End-to-end ML pipelines, workflow automation & model lifecycle monitoring" },
    ],
  },
];

const targetRoles = [
  "Junior Cloud ML Engineer",
  "Junior Cloud Engineer",
  "Cloud Operations Associate",
  "Cloud Support Engineer",
  "ML Platform Support / Operations",
  "Junior Machine Learning Engineer",
  "Junior MLOps Engineer",
];
---

<Layout title="Satyajit Chakraborty | Business Operations to Cloud Engineering & MLOps">
  <!-- Hero / Refined Homepage Introduction -->
  <section class="py-6 md:py-10 space-y-6">
    <div class="inline-flex items-center gap-2 rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-3 py-1 text-xs font-mono text-brand-accent-light dark:text-brand-accent-dark">
      <span>Kolkata, India (IST) · 9 Yrs 5 Mos at TCS BPS → Cloud Engineering &amp; MLOps</span>
    </div>

    <div class="space-y-4 max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-brand-ink dark:text-brand-cream leading-tight">
        Satyajit Chakraborty <br />
        <span class="text-xl md:text-2xl font-semibold text-brand-accent-light dark:text-brand-accent-dark">
          Business Operations to Cloud Engineering, Cloud ML &amp; MLOps
        </span>
      </h1>

      <div class="space-y-3 text-sm md:text-base text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        <p>
          I am a business operations professional with <strong class="font-semibold text-brand-ink dark:text-brand-cream">9 years and 5 months of experience at Tata Consultancy Services (TCS BPS)</strong>, working across financial services, UK pension administration (NEST), US healthcare operations, data validation, and quality assurance.
        </p>
        <p>
          My interest in technology began in 2021 through collaboration with <strong class="font-semibold text-brand-ink dark:text-brand-cream">Robotic Process Automation (RPA)</strong> teams, where I shared operational workflows and helped explain existing business processes. Since then, I have progressively developed an interest in Python, Machine Learning, and Cloud technologies. After completing my professional tenure at TCS in December 2024, I dedicated time to strengthening my technical foundations through structured learning and practical development.
        </p>
        <p>
          I am now pursuing opportunities in <strong class="font-semibold text-brand-ink dark:text-brand-cream">Junior Cloud Engineering, Cloud ML, Cloud Operations, and MLOps</strong>, where I can combine my professional experience in operational reliability, troubleshooting, data integrity, and stakeholder communication with my developing engineering capabilities. I believe in being transparent about my current technical capabilities, continuously learning, and demonstrating progress through practical projects.
        </p>
      </div>

      <!-- Target Roles Pills -->
      <div class="pt-2 space-y-2">
        <p class="font-mono text-[11px] uppercase tracking-wider font-semibold text-brand-forest-light dark:text-brand-forest-dark">
          Open to Junior Roles — Kolkata On-Site/Hybrid · Rest of India Remote (Offer-Dependent) · Global EOR &amp; B2B Remote:
        </p>
        <div class="flex flex-wrap gap-1.5">
          {targetRoles.map((role) => (
            <span class="rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-2.5 py-1 text-xs font-mono text-brand-ink dark:text-brand-cream">
              {role}
            </span>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-3">
        <a
          href="/projects"
          class="inline-flex items-center justify-center rounded-md bg-brand-accent-light dark:bg-brand-accent-dark px-4 py-2 text-xs sm:text-sm font-semibold text-[#F1E6C8] dark:text-brand-slate transition-transform hover:scale-[1.02]"
        >
          View Projects
        </a>
        <a
          href="/logbook"
          class="inline-flex items-center justify-center rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-4 py-2 text-xs sm:text-sm font-semibold text-brand-ink dark:text-brand-cream hover:border-brand-accent-light transition-colors"
        >
          Engineering Logbook ({adrCount} ADRs · {hurdleCount} Hurdles)
        </a>
        <button
          type="button"
          data-open-ai-chat
          class="inline-flex items-center justify-center rounded-md border border-brand-forest-light/50 dark:border-brand-forest-dark/50 bg-brand-surface dark:bg-brand-slate-surface px-4 py-2 text-xs sm:text-sm font-semibold text-brand-forest-light dark:text-brand-forest-dark hover:border-brand-forest-light cursor-pointer"
        >
          Ask Edge AI Assistant
        </button>
      </div>
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-8" />

  <!-- Section 1: Professional Experience at TCS -->
  <section class="space-y-6">
    <div class="space-y-2">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        01 · Enterprise Experience (July 2015 – December 2024)
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Tata Consultancy Services (TCS BPS) — 9 Years &amp; 5 Months
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        Academic Qualification: <strong class="font-semibold text-brand-ink dark:text-brand-cream">Bachelor of Commerce (Honours) in Accounting and Finance — University of Calcutta</strong>.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {tcsExperience.map((exp) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 space-y-3">
          <div>
            <h3 class="text-base font-bold text-brand-ink dark:text-brand-cream">{exp.role}</h3>
            <p class="text-xs font-mono text-brand-accent-light dark:text-brand-accent-dark mt-0.5">{exp.project}</p>
          </div>
          <ul class="space-y-2 text-xs text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed list-disc pl-4">
            {exp.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-10" />

  <!-- Section 2: Recognition & Professional Development -->
  <section class="space-y-6">
    <div class="space-y-2">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-forest-light dark:text-brand-forest-dark">
        02 · Recognition &amp; Professional Development
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Awards &amp; Recognition at Tata Consultancy Services
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        During my 9 years and 5 months at Tata Consultancy Services, I received several recognitions for professional performance, service commitment, and continuous learning. Certificate previews load strictly on demand when clicked.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {tcsAwards.map((award) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-5 flex flex-col justify-between gap-3">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-brand-forest-light dark:bg-brand-forest-dark"></span>
              <h3 class="text-sm font-bold text-brand-ink dark:text-brand-cream">{award.title}</h3>
            </div>
            <p class="text-xs text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed pl-4">
              {award.detail}
            </p>
          </div>

          {award.certificates.length > 0 && (
            <div class="flex flex-wrap gap-2 pl-4 pt-1">
              {award.certificates.map((cert) => (
                <button
                  type="button"
                  data-cert-src={cert.src}
                  data-cert-title={cert.title}
                  class="inline-flex items-center rounded border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 font-mono text-[11px] font-medium text-brand-accent-light dark:text-brand-accent-dark hover:border-brand-accent-light dark:hover:border-brand-accent-dark transition-colors cursor-pointer"
                >
                  {cert.label}
                </button>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-10" />

  <!-- Section 3: Transparent 3-Tier Technical Skill Classification -->
  <section class="space-y-6">
    <div class="space-y-2">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        03 · Transparent Technical Skill Classification &amp; Verified Credentials
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        What I Have Demonstrated, What I Am Practising &amp; What Is Next
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        I distinguish clearly between knowing a concept, implementing it independently, and maintaining it in a production environment. External certifications link directly to their official issuer verification pages:
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {skillTiers.map((group) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 space-y-3 flex flex-col">
          <div class="space-y-1 border-b border-brand-border/60 dark:border-brand-slate-border pb-3">
            <h3 class={`text-xs font-mono uppercase tracking-wider font-bold ${group.badgeClass}`}>
              {group.tier}
            </h3>
            <p class="text-[11px] text-brand-ink-muted dark:text-brand-cream-muted">
              {group.meaning}
            </p>
          </div>
          <ul class="space-y-2.5 text-xs text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed list-disc pl-4 flex-1">
            {group.items.map((item) => (
              <li>
                <span>{item.text}</span>
                {item.verifyUrl && (
                  <a
                    href={item.verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-1.5 inline-block font-mono text-[11px] font-semibold text-brand-accent-light dark:text-brand-accent-dark underline decoration-brand-border dark:decoration-brand-slate-border underline-offset-2 hover:decoration-current"
                  >
                    {item.verifyLabel ?? "Verify ↗"}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="border-t border-brand-border dark:border-brand-slate-border my-10" />

  <!-- Section 4: Learning Approach & Honest Comfort Level -->
  <section class="space-y-6">
    <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 sm:p-8 space-y-4">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-forest-light dark:text-brand-forest-dark">
        04 · Learning Approach &amp; Honest Technical Comfort Level
      </p>
      <h2 class="text-xl font-bold text-brand-ink dark:text-brand-cream">
        First-Principles Understanding &amp; Collaborative Growth
      </h2>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        I consider myself to be in the <strong class="font-semibold text-brand-ink dark:text-brand-cream">technical transition and skill-development stage</strong> rather than an experienced Cloud or MLOps engineer. While I do not claim senior production proficiency across every tool, I am confident in my ability to learn unfamiliar technologies, read technical documentation, investigate discrepancies systematically, and contribute reliably within a collaborative engineering team.
      </p>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        My approach is to understand <em>why</em> a technology exists, what problem it solves, and where it is useful rather than collecting buzzwords—whether adopting <strong class="font-semibold text-brand-ink dark:text-brand-cream">Astral&apos;s uv</strong> for reproducible Python environments, studying for the <strong class="font-semibold text-brand-ink dark:text-brand-cream">Google Cloud Professional Machine Learning Engineer</strong> certification (targeted for December 2026), or following computational efficiency research such as <strong class="font-semibold text-brand-ink dark:text-brand-cream">Stanford&apos;s NCM project</strong>.
      </p>
    </div>
  </section>

  <!-- On-Demand Certificate Preview Dialog (0 KB Loaded Until Clicked) -->
  <dialog
    id="cert-modal"
    aria-labelledby="cert-modal-title"
    class="m-auto w-[92vw] max-w-3xl rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-0 text-brand-ink dark:text-brand-cream shadow-2xl backdrop:bg-black/75"
  >
    <div class="flex items-center justify-between gap-4 border-b border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-4 py-3">
      <h3 id="cert-modal-title" class="font-mono text-xs sm:text-sm font-semibold text-brand-ink dark:text-brand-cream">
        Certificate Preview
      </h3>
      <button
        id="cert-modal-close"
        type="button"
        class="rounded border border-brand-border dark:border-brand-slate-border bg-brand-paper dark:bg-brand-slate px-2.5 py-1 font-mono text-xs text-brand-ink dark:text-brand-cream hover:border-brand-accent-light cursor-pointer"
        aria-label="Close certificate preview"
      >
        Close ✕
      </button>
    </div>
    <div class="flex items-center justify-center bg-brand-paper/70 dark:bg-brand-slate/70 p-4">
      <img
        id="cert-modal-img"
        alt=""
        class="max-h-[75vh] w-auto rounded-lg border border-brand-border dark:border-brand-slate-border object-contain"
      />
    </div>
  </dialog>

  <script src="../scripts/cert-lightbox.ts"></script>
</Layout>
