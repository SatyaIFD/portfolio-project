---
import Layout from "../layouts/Layout.astro";

const profilePillars = [
  {
    category: "Cloud & MLOps Focus",
    title: "Google Cloud & Edge AI",
    items: [
      "Finalizing ground-up refresher for the Google Cloud Professional ML Engineer certification",
      "Designing real-time fraud detection pipelines (Pub/Sub, Dataflow, BigQuery, Vertex AI)",
      "Building zero-cost serverless RAG architectures on Cloudflare Workers AI & Vectorize",
    ],
  },
  {
    category: "DevSecOps & Linux Craft",
    title: "Verifiable Engineering",
    items: [
      "Test-driven Python 3.13 development (Pytest 98.78% coverage, Mypy, Ruff, Bandit, pip-audit)",
      "Ubuntu Linux administration, OS Keyring (libsecret) secret injection, and rclone cron automation",
      "Strict GitHub Actions CI/CD security gates with zero plaintext .env files",
    ],
  },
  {
    category: "AI Philosophy & Role Fit",
    title: "Team Collaborator, Not a Consultant",
    items: [
      "Use AI assistants transparently as engineering force-multipliers backed by deterministic tests",
      "Document every architectural decision (ADR) and operational hurdle openly",
      "Seeking Domestic (India), Global EOR, or B2B roles as an integrated, hands-on team member",
    ],
  },
];

const starterPrompts = [
  "Who is Satyajit and what roles is he looking for?",
  "Which LLM model and vector database power this portfolio?",
  "How does ADR 006 protect the 10,000 daily free Neurons budget?",
  "How are credentials managed securely without plaintext .env files?",
];
---

<Layout title="Satyajit | MLOps, Cloud Architecture & DevSecOps (VraiDaten)">
  <!-- Hero Section -->
  <section class="py-10 md:py-16 space-y-6">
    <div class="inline-flex items-center gap-2 rounded-md border border-[#003399]/25 dark:border-[#5B8DEF]/30 bg-[#003399]/5 dark:bg-[#5B8DEF]/10 px-3 py-1 text-xs font-mono text-brand-accent-light dark:text-brand-accent-dark">
      <span>VraiDaten (&ldquo;True Data&rdquo;) · Verifiable MLOps &amp; Cloud Engineering</span>
    </div>

    <div class="space-y-5 max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-brand-ink dark:text-brand-cream leading-tight">
        Hi, I&apos;m Satyajit. <br class="hidden sm:block" />
        <span class="text-brand-accent-light dark:text-brand-accent-dark">Building Reliable Cloud</span>
        <span class="text-brand-forest-light dark:text-brand-forest-dark"> &amp; MLOps Systems.</span>
      </h1>

      <p class="text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
        I am a hands-on engineer focused on <strong class="font-semibold text-brand-ink dark:text-brand-cream">Cloud Architecture, MLOps, and DevSecOps</strong>. Rather than claiming to know everything, I believe in learning from first principles, enforcing automated quality and security gates, and documenting every architectural trade-off and troubleshooting hurdle along the way.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="#about-me" class="inline-flex items-center justify-center rounded-md bg-brand-accent-light dark:bg-brand-accent-dark px-5 py-2.5 text-sm font-semibold text-white dark:text-brand-slate transition-transform hover:scale-[1.02]">
          About Me &amp; My Stack
        </a>
        <a href="#rag-studio" class="inline-flex items-center justify-center rounded-md border border-[#006400]/40 dark:border-[#4E9F6E]/40 bg-[#006400]/10 dark:bg-[#4E9F6E]/15 px-5 py-2.5 text-sm font-semibold text-brand-forest-light dark:text-brand-forest-dark transition-colors hover:bg-[#006400]/20">
          Ask Edge AI
        </a>
        <a href="/projects" class="inline-flex items-center justify-center rounded-md border border-[#E0DCD3] dark:border-[#1E252B] bg-white/60 dark:bg-[#13151A] px-5 py-2.5 text-sm font-medium text-brand-ink dark:text-brand-cream hover:border-brand-accent-light transition-colors">
          View Projects
        </a>
      </div>
    </div>
  </section>

  <hr class="border-t border-[#E0DCD3] dark:border-[#1E252B] my-10" />

  <!-- About Me, Background & Philosophy Section -->
  <section id="about-me" class="scroll-mt-24 space-y-10">
    <div class="space-y-3 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-forest-light dark:text-brand-forest-dark">
        01 · Profile, Stack &amp; Working Style
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        About Me &amp; What I Bring to an Engineering Team
      </h2>
      <p class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
        I am currently completing a comprehensive ground-up refresher for the <strong class="font-semibold text-brand-ink dark:text-brand-cream">Google Cloud Professional Machine Learning Engineer</strong> certification and building production-grade MLOps pipelines. I am open to <strong class="font-semibold text-brand-ink dark:text-brand-cream">Domestic (India), Global EOR, or B2B Contract</strong> positions—specifically as an <strong class="font-semibold text-brand-accent-light dark:text-brand-accent-dark">integrated team collaborator</strong> working inside shared repositories, code reviews, and sprint cycles, rather than as an external consultant.
      </p>
    </div>

    <!-- 3-Column Pillar Grid -->
    <div class="grid gap-6 md:grid-cols-3">
      {profilePillars.map((pillar) => (
        <div class="rounded-xl border border-[#E0DCD3] dark:border-[#1E252B] bg-white/80 dark:bg-[#13151A] p-6 space-y-4">
          <div>
            <span class="font-mono text-[11px] uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
              {pillar.category}
            </span>
            <h3 class="mt-1 text-base font-bold text-brand-ink dark:text-brand-cream">
              {pillar.title}
            </h3>
          </div>
          <ul class="space-y-2.5 text-xs text-slate-700 dark:text-slate-300 leading-relaxed list-disc pl-4">
            {pillar.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Personal Context: Why VraiDaten, Languages & Chess -->
    <div class="rounded-xl border border-[#E0DCD3] dark:border-[#1E252B] bg-white/60 dark:bg-[#13151A]/80 p-6 sm:p-8 grid gap-6 md:grid-cols-2">
      <div class="space-y-2">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark font-mono">
          Why &ldquo;VraiDaten&rdquo; &amp; This Design?
        </h3>
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          Outside of cloud engineering, I study the <strong class="font-semibold text-brand-ink dark:text-brand-cream">German and Japanese languages</strong> and play <strong class="font-semibold text-brand-ink dark:text-brand-cream">chess</strong>. <em>VraiDaten</em> blends European roots (<em>Vrai</em> + <em>Daten</em> — &ldquo;True Data&rdquo;), reflected in the Royal Blue (<code class="font-mono text-xs">#003399</code>) and Forest Green (<code class="font-mono text-xs">#006400</code>) palette, with Japanese structural minimalism (<em>Ma</em> negative space and <em>Kanso</em> simplicity) for an eye-friendly reading experience.
        </p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-forest-light dark:text-brand-forest-dark font-mono">
          Honest AI Collaboration
        </h3>
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          I actively use AI tools as learning and productivity multipliers, but never as a substitute for understanding. Every component in this repository is built step-by-step, type-checked with <code class="font-mono text-xs">mypy</code> and <code class="font-mono text-xs">tsc</code>, scanned with <code class="font-mono text-xs">bandit</code> and <code class="font-mono text-xs">detect-secrets</code>, and validated with <code class="font-mono text-xs">pytest</code>.
        </p>
      </div>
    </div>
  </section>

  <hr class="border-t border-[#E0DCD3] dark:border-[#1E252B] my-12" />

  <!-- RAG Studio Section -->
  <section id="rag-studio" class="scroll-mt-24">
    <div class="mb-6 space-y-2">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        02 · Interactive Architecture Verification
      </p>
      <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Ask Edge AI About My Work
      </h2>
      <p class="text-sm text-slate-700 dark:text-slate-300">
        This RAG assistant (<code class="font-mono text-brand-accent-light dark:text-brand-accent-dark text-xs">@cf/ibm-granite/granite-4.0-h-micro</code>) is grounded strictly in my repository&apos;s verified documentation (ADRs 001–011 &amp; Hurdles 001–017) via Cloudflare Vectorize.
      </p>
    </div>

    <!-- Chat Console -->
    <div class="rounded-xl border border-[#E0DCD3] dark:border-[#1E252B] bg-white dark:bg-[#13151A] shadow-sm overflow-hidden flex flex-col h-[500px]">
      
      <!-- Transparency Header -->
      <div class="border-b border-[#E0DCD3] dark:border-[#1E252B] bg-[#F4F2EC]/60 dark:bg-[#0F1115] px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="flex h-2 w-2 rounded-full bg-[#006400] dark:bg-[#4E9F6E] animate-pulse"></span>
          <span class="text-[11px] font-mono font-medium uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Live Edge RAG Session (vraidaten-index)
          </span>
        </div>
        <span class="text-[10px] font-mono text-slate-600 dark:text-slate-400">
          EU AI Act Art. 50 Disclosed · GDPR Zero-PII
        </span>
      </div>

      <!-- Scrollable Message Area -->
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-transparent">
        <div class="flex justify-start">
          <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-[#F4F2EC] dark:bg-[#1E252B] border border-[#E0DCD3] dark:border-slate-700 px-4 py-3 text-sm text-brand-ink dark:text-slate-200 leading-relaxed">
            Welcome! Click a starter prompt below or ask any question about Satyajit&apos;s background, target roles, MLOps architecture, or CI/CD security gates.
          </div>
        </div>
      </div>

      <!-- Input Area & Starter Prompts -->
      <div class="border-t border-[#E0DCD3] dark:border-[#1E252B] bg-[#F4F2EC]/60 dark:bg-[#0F1115] p-4">
        <div class="mb-3 flex flex-wrap gap-2">
          {starterPrompts.map((prompt) => (
            <button
              type="button"
              data-starter-prompt={prompt}
              class="rounded-md border border-[#E0DCD3] dark:border-[#1E252B] bg-white dark:bg-[#13151A] px-2.5 py-1 text-left text-[11px] text-slate-700 dark:text-slate-300 transition hover:border-brand-accent-light dark:hover:border-brand-accent-dark hover:text-brand-accent-light dark:hover:text-brand-accent-dark cursor-pointer"
            >
              {prompt}
            </button>
          ))}
        </div>

        <form id="chat-form" class="relative">
          <label for="chat-input" class="sr-only">Ask a question</label>
          <textarea
            id="chat-input"
            name="prompt"
            rows="2"
            maxlength="500"
            required
            placeholder="Ask about Satyajit, his GCP ML Engineer track, or how this platform is built..."
            class="w-full resize-none rounded-lg border border-[#E0DCD3] dark:border-[#1E252B] bg-white dark:bg-[#13151A] px-3.5 py-2.5 text-sm text-brand-ink dark:text-brand-cream placeholder-slate-400 dark:placeholder-slate-500 focus:border-brand-accent-light dark:focus:border-brand-accent-dark focus:ring-1 focus:ring-brand-accent-light dark:focus:ring-brand-accent-dark focus:outline-none"
          ></textarea>
          
          <div class="mt-2 flex items-center justify-between">
            <span id="char-count" class="font-mono text-[10px] text-slate-600 dark:text-slate-400">0 / 500</span>
            <button
              id="chat-submit"
              type="submit"
              class="rounded-md bg-brand-accent-light dark:bg-brand-accent-dark px-4 py-1.5 text-xs font-semibold text-white dark:text-brand-slate transition-transform hover:scale-[1.02] disabled:opacity-50 cursor-pointer"
            >
              Send
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script src="../scripts/chat-client.ts"></script>
</Layout>
