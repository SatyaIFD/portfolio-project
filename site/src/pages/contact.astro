---
import Layout from "../layouts/Layout.astro";

const engagementModels = [
  {
    title: "Domestic Full-Time Employment",
    scope: "India (Remote / Hybrid / On-Site)",
    detail:
      "Available to join product and platform engineering teams building cloud infrastructure, MLOps pipelines, and automated DevSecOps workflows.",
  },
  {
    title: "Global EOR (Employer of Record)",
    scope: "International Teams (Deel / Remote / Oyster)",
    detail:
      "Open to full-time international roles via standard Employer of Record platforms as a dedicated, long-term engineering team member.",
  },
  {
    title: "B2B Collaborative Contract",
    scope: "Embedded Team Collaborator",
    detail:
      "Available for structured B2B contracts where I work hands-on inside your repositories, CI/CD pipelines, and sprint cycles—as a team collaborator rather than an external advisor.",
  },
];
---

<Layout
  title="Contact & Collaboration | Satyajit"
  description="Connect with Satyajit for MLOps, Cloud Architecture, and DevSecOps roles."
>
  <section class="py-8 md:py-12 space-y-12">
    <div class="space-y-4 max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Work Arrangements &amp; Reachability
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Contact &amp; Collaboration
      </h1>
      <p class="text-sm md:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
        I am looking for hands-on engineering roles where I can contribute directly to cloud infrastructure, MLOps automation, and DevSecOps reliability while continuing to grow alongside an experienced engineering team.
      </p>
    </div>

    <!-- Engagement Models Grid -->
    <div class="grid gap-6 md:grid-cols-3">
      {engagementModels.map((model) => (
        <div class="rounded-xl border border-[#E0DCD3] dark:border-[#1E252B] bg-white/70 dark:bg-[#13151A] p-6 space-y-3">
          <span class="font-mono text-[11px] uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
            {model.scope}
          </span>
          <h2 class="text-base font-bold text-brand-ink dark:text-brand-cream">
            {model.title}
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            {model.detail}
          </p>
        </div>
      ))}
    </div>

    <!-- Direct Channels -->
    <div class="rounded-xl border border-[#E0DCD3] dark:border-[#1E252B] bg-white/70 dark:bg-[#13151A] p-6 sm:p-8 space-y-6">
      <div class="space-y-2">
        <h2 class="text-lg font-bold text-brand-ink dark:text-brand-cream">
          Direct Engineering Channels
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          Review the full source code, CI/CD security gates, and commit history on GitHub, or test the live RAG assistant on the Home page.
        </p>
      </div>

      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/SatyaIFD/portfolio-project"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md bg-brand-ink dark:bg-brand-cream px-5 py-2.5 text-xs font-semibold text-brand-paper dark:text-brand-slate transition-transform hover:scale-[1.02]"
        >
          GitHub Repository (SatyaIFD)
        </a>
        <a
          href="https://github.com/SatyaIFD"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border border-[#E0DCD3] dark:border-[#1E252B] px-5 py-2.5 text-xs font-medium text-brand-ink dark:text-brand-cream hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          GitHub Profile
        </a>
        <a
          href="/#rag-studio"
          class="inline-flex items-center justify-center rounded-md border border-[#E0DCD3] dark:border-[#1E252B] px-5 py-2.5 text-xs font-medium text-brand-ink dark:text-brand-cream hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          Ask Edge AI About My Work
        </a>
      </div>
    </div>
  </section>
</Layout>
