---
import Layout from "../layouts/Layout.astro";

const targetRoles = [
  "Junior Cloud ML Engineer",
  "Junior Cloud Engineer",
  "Cloud Operations Associate",
  "Cloud Support Engineer",
  "ML Platform Support / Operations",
  "Junior Machine Learning Engineer (Deployment & Infrastructure)",
  "Junior MLOps Engineer",
];

const engagementModels = [
  {
    title: "Domestic Employment (India)",
    scope: "Junior / Entry-Level Technical Roles",
    detail:
      "Open to full-time junior and career-transition-friendly technical opportunities across India where I can combine my 9.5 years of TCS operational experience with cloud and MLOps engineering.",
  },
  {
    title: "Global EOR (Employer of Record)",
    scope: "International Engineering Teams",
    detail:
      "Available for full-time international positions via standard Employer of Record platforms as a dedicated, long-term team member.",
  },
  {
    title: "B2B Collaborative Contract",
    scope: "Integrated Team Collaborator",
    detail:
      "Open to structured B2B contracts working hands-on inside your team's repositories, operational queues, and sprint cycles—as a collaborative team member rather than an external consultant.",
  },
];
---

<Layout
  title="Contact & Target Roles | Satyajit Chakraborty"
  description="Connect with Satyajit Chakraborty for Junior Cloud Engineering, Cloud Operations, and MLOps roles."
>
  <section class="py-6 md:py-10 space-y-10">
    <div class="space-y-3 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Target Opportunities &amp; Direct Contact
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Contact &amp; Career Opportunities
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        I am open to starting at an appropriate junior or entry-level technical position where I can apply my 9.5 years of operational and quality assurance strengths from TCS, learn from experienced engineers, and progressively take ownership of Cloud and MLOps responsibilities.
      </p>
    </div>

    <!-- Target Roles List -->
    <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 space-y-4">
      <h2 class="text-base font-bold text-brand-ink dark:text-brand-cream">
        Preferred Junior &amp; Transition-Friendly Roles
      </h2>
      <div class="flex flex-wrap gap-2">
        {targetRoles.map((role) => (
          <span class="rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-3 py-1.5 text-xs font-mono text-brand-ink dark:text-brand-cream">
            {role}
          </span>
        ))}
      </div>
    </div>

    <!-- Work Arrangements Grid -->
    <div class="grid gap-6 md:grid-cols-3">
      {engagementModels.map((model) => (
        <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 space-y-2.5">
          <span class="font-mono text-[11px] uppercase tracking-wider text-brand-forest-light dark:text-brand-forest-dark">
            {model.scope}
          </span>
          <h2 class="text-base font-bold text-brand-ink dark:text-brand-cream">
            {model.title}
          </h2>
          <p class="text-xs text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
            {model.detail}
          </p>
        </div>
      ))}
    </div>

    <!-- Direct Contact Card -->
    <div class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 sm:p-8 space-y-5">
      <div class="space-y-1.5">
        <h2 class="text-lg font-bold text-brand-ink dark:text-brand-cream">
          Connect Directly with Satyajit Chakraborty
        </h2>
        <p class="text-xs text-brand-ink-muted dark:text-brand-cream-muted">
          B.Com (Honours), Accounting and Finance — University of Calcutta · 9 Yrs 5 Mos at Tata Consultancy Services (TCS BPS)
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="https://www.linkedin.com/in/satyajitchakraborty91"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md bg-brand-accent-light dark:bg-brand-accent-dark px-5 py-2.5 text-xs font-semibold text-[#E7E2D6] dark:text-brand-slate transition-transform hover:scale-[1.02]"
        >
          LinkedIn (satyajitchakraborty91)
        </a>
        <a
          href="https://github.com/SatyaIFD/portfolio-project"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-5 py-2.5 text-xs font-medium text-brand-ink dark:text-brand-cream hover:border-brand-accent-light transition-colors"
        >
          GitHub Repository (SatyaIFD)
        </a>
        <button
          type="button"
          data-open-ai-chat
          class="inline-flex items-center justify-center rounded-md border border-brand-forest-light/50 dark:border-brand-forest-dark/50 bg-brand-recessed dark:bg-brand-slate-recessed px-5 py-2.5 text-xs font-semibold text-brand-forest-light dark:text-brand-forest-dark hover:border-brand-forest-light cursor-pointer"
        >
          Ask Edge AI About My Profile
        </button>
      </div>
    </div>
  </section>
</Layout>
