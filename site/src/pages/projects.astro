---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    title: "Current Project: VraiDaten Portfolio & Edge RAG Website (vraidaten.com)",
    status: "Active Development & Live Deployment",
    timeline: "Current Priority",
    role: "Cloud & DevSecOps Workflow Implementation",
    stack: [
      "Python 3.13",
      "Astral uv",
      "Pytest / Ruff / Mypy / Bandit",
      "Astro",
      "Tailwind CSS",
      "Cloudflare Workers & Vectorize",
      "GitHub Actions CI/CD",
      "Linux libsecret Keyring",
    ],
    description:
      "My immediate practical priority: building, securing, and documenting this portfolio website while strengthening my understanding of modern development workflows. Implements a local Markdown ingestion pipeline, OS Keyring credential injection (zero plaintext .env files), automated CI security gates, and a floating Edge RAG assistant grounded in the repository's Architectural Decision Records (ADRs) and troubleshooting Hurdle logs.",
    goals: [
      "Practice end-to-end Git branching, pull request checks, and automated CI/CD security scanning.",
      "Document every architectural decision (ADRs 001–011) and operational hurdle (Hurdles 001–017) transparently.",
      "Operate within strict $0/month free-tier resource boundaries using lightweight edge models.",
    ],
  },
  {
    title: "Planned Project: Google Cloud End-to-End Implementation",
    status: "Planned (Commencing After Website Completion)",
    timeline: "Next Milestone",
    role: "Cloud Engineering & Cloud ML Practice",
    stack: [
      "Google Cloud Platform (GCP)",
      "Cloud IAM & Resource Management",
      "Python Automation",
      "Containerization (Docker)",
      "Monitoring & Logging",
      "ML Model Serving",
    ],
    description:
      "After completing this website project, I will undertake an end-to-end Google Cloud implementation. The exact use case and architecture are currently being evaluated so that the project genuinely demonstrates core competencies in cloud infrastructure provisioning, application deployment, automation, monitoring, and troubleshooting—incorporating a machine learning component to connect my Data Science foundation with Cloud ML operations.",
    goals: [
      "Apply concepts from my Google Cloud Professional ML Engineer study track (targeted for December 2026) in a real GCP environment.",
      "Demonstrate practical IAM least-privilege configuration, structured logging, and reproducible deployment.",
      "Publish full architectural documentation and troubleshooting logs as the scope and implementation become concrete.",
    ],
  },
];
---

<Layout title="Projects | Satyajit Chakraborty" description="Current and planned practical projects in Cloud Engineering and MLOps.">
  <section class="py-6 md:py-10 space-y-10">
    <div class="space-y-3 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Practical Implementation &amp; Roadmap
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Current &amp; Planned Projects
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        Rather than listing dozens of superficial tutorials, I focus on completing and thoroughly documenting one practical project at a time—recording both the architecture and the troubleshooting hurdles encountered along the way.
      </p>
    </div>

    <div class="space-y-8">
      {projects.map((project) => (
        <article class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 sm:p-8 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 text-[11px] font-mono font-semibold text-brand-accent-light dark:text-brand-accent-dark">
              {project.status}
            </span>
            <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
              {project.timeline} · {project.role}
            </span>
          </div>

          <h2 class="text-xl font-bold text-brand-ink dark:text-brand-cream">
            {project.title}
          </h2>

          <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
            {project.description}
          </p>

          <div class="space-y-2">
            <h3 class="text-xs font-mono uppercase tracking-wider font-semibold text-brand-forest-light dark:text-brand-forest-dark">
              Key Learning &amp; Engineering Objectives
            </h3>
            <ul class="space-y-1.5 text-xs text-brand-ink-muted dark:text-brand-cream-muted list-disc pl-4">
              {project.goals.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-brand-border/60 dark:border-brand-slate-border">
            {project.stack.map((tech) => (
              <span class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 text-[11px] font-mono text-brand-ink dark:text-brand-cream">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
