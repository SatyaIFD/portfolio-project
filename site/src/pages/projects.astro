---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    title: "Vraidaten Edge RAG & DevSecOps Platform",
    status: "Live in Production",
    timeline: "Nov 2026",
    role: "Cloud Architecture & MLOps",
    link: "https://vraidaten.com",
    github: "https://github.com/SatyaIFD/portfolio-project",
    stack: [
      "Astro 7",
      "Cloudflare Workers",
      "Workers AI (@cf/ibm-granite)",
      "Cloudflare Vectorize",
      "Python 3.13",
      "Pytest",
      "GitHub Actions"
    ],
    description: "A zero-cost serverless Edge AI portfolio operating within strict Cloudflare free-tier quotas. Features a fully automated Python ingestion pipeline for Markdown ADRs, OS Keyring (libsecret) secure credential injection to eliminate plaintext `.env` files, and a 9-gate DevSecOps CI/CD pipeline achieving 98.78% test coverage.",
    metrics: [
      { label: "RAG Cost", value: "~1.6 Neurons / Query" },
      { label: "Vector Dimension", value: "384 (Cosine)" },
      { label: "Edge Latency", value: "< 50ms (Cache Hit)" }
    ]
  },
  {
    title: "Real-Time Banking Fraud Detection Pipeline",
    status: "In Development (Post-Certification)",
    timeline: "Upcoming",
    role: "GCP MLOps Engineer",
    link: "#",
    github: "#",
    stack: [
      "Google Cloud Platform",
      "Pub/Sub",
      "Dataflow",
      "BigQuery",
      "Vertex AI",
      "Terraform"
    ],
    description: "An end-to-end streaming architecture for detecting anomalous transaction patterns across Credit Card, Debit Card, and Netbanking networks. Designed to validate GCP Professional Machine Learning Engineer competencies through low-latency model inference, robust feature stores, and automated model monitoring.",
    metrics: [
      { label: "Target Latency", value: "< 200ms" },
      { label: "Compliance", value: "GDPR & DORA" },
      { label: "Infra as Code", value: "Terraform" }
    ]
  }
];
---

<Layout title="Projects | Satyajit" description="Production MLOps and Cloud Architecture engineering case studies.">
  <section class="py-8 md:py-12">
    <div class="space-y-4 mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">Engineering Projects</h1>
      <p class="text-sm md:text-base text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Production systems engineered with strict typing, automated security gates, and cost-bounded infrastructure. I prioritize verifiable CI/CD workflows and architectural transparency over "black box" deployment.
      </p>
    </div>

    <div class="grid gap-12">
      {projects.map((project) => (
        <article class="flex flex-col md:flex-row gap-6 md:gap-10 items-start border-t border-[#E0DCD3] dark:border-[#1E252B] pt-8">
          
          <!-- Left Column: Meta -->
          <div class="w-full md:w-1/4 space-y-4 shrink-0">
            <div>
              <span class={`inline-block px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider rounded-md border ${project.status === "Live in Production" ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400"}`}>
                {project.status}
              </span>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">{project.timeline}</p>
              <p class="text-sm font-semibold text-brand-ink dark:text-brand-cream mt-1">{project.role}</p>
            </div>
            
            <div class="pt-2">
              <div class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <span class="rounded bg-[#E0DCD3]/50 dark:bg-[#1E252B] px-2 py-0.5 text-[10px] font-mono text-slate-600 dark:text-slate-400">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Right Column: Content -->
          <div class="w-full md:w-3/4 space-y-5">
            <div>
              <h2 class="text-xl font-bold text-brand-ink dark:text-brand-cream">{project.title}</h2>
            </div>
            
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
              {project.description}
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-[#E0DCD3]/50 dark:border-[#1E252B]/50">
              {project.metrics.map((metric) => (
                <div>
                  <p class="text-[10px] uppercase tracking-wider font-medium text-slate-500">{metric.label}</p>
                  <p class="text-sm font-mono font-semibold text-brand-accent-light dark:text-brand-accent-dark mt-1">{metric.value}</p>
                </div>
              ))}
            </div>
          </div>

        </article>
      ))}
    </div>
  </section>
</Layout>
