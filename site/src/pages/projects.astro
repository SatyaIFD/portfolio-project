---
import Layout from "../layouts/Layout.astro";

const adrCount = Object.keys(import.meta.glob("../../../docs/projects/vraidaten-portfolio/decisions/*.md")).length;
const hurdleCount = Object.keys(import.meta.glob("../../../docs/projects/vraidaten-portfolio/hurdles/*.md")).length;
const gcpSpecCount = Object.keys(import.meta.glob("../../../docs/projects/gcp-end-to-end/*.md")).length;
const gcpAdrCount = Object.keys(import.meta.glob("../../../docs/projects/gcp-end-to-end/decisions/*.md")).length;
const gcpHurdleCount = Object.keys(import.meta.glob("../../../docs/projects/gcp-end-to-end/hurdles/*.md")).length;

const projects = [
  {
    title: "VraiDaten Portfolio & Edge AI Assistant (vraidaten.com)",
    status: "Live · v1.0.0 Released",
    timeline: "Completed & Maintained",
    role: "Cloud Engineering & Edge AI Implementation",
    repoUrl: "https://github.com/SatyaIFD/portfolio-project",
    repoLabel: "View portfolio-project on GitHub",
    logbookUrl: "/logbook",
    stack: [
      "Python 3.13",
      "Astral uv",
      "Pytest / Ruff / Mypy",
      "Astro 7",
      "Tailwind CSS v4",
      "Cloudflare Workers & Vectorize",
      "GitHub Actions CI/CD",
      "Linux libsecret Keyring",
    ],
    description:
      "Production career-transition portfolio and grounded Edge RAG assistant operating at $0/month within Cloudflare free-tier boundaries. Implements a local Python hierarchical section-chunking pipeline, Cloudflare Vectorize (384-dim BGE embeddings), OS Keyring credential injection (zero plaintext .env files), automated DevSecOps checks, and a compile-time synchronized Engineering Logbook.",
    goals: [
      "Practised end-to-end Git branching, protected rulesets, automated unit testing (25 Pytest tests, 92%+ coverage), and CI/CD security gates.",
      `Documented every architectural decision (${adrCount} ADRs) and operational troubleshooting hurdle (${hurdleCount} Hurdles) transparently in the Engineering Logbook.`,
      "Engineered a $0/month edge inference assistant (@cf/ibm-granite/granite-4.0-h-micro with Gemma fallback), GDPR zero-PII guardrails, and Edge-to-Python schema parity.",
    ],
  },
  {
    title: "Google Cloud End-to-End MLOps: Claims & Transaction QA Triage",
    status: "Active · Phase 0 Complete (Scaffolding & Governance)",
    timeline: "Current Build",
    role: "Cloud ML & MLOps Engineering",
    repoUrl: "https://github.com/SatyaIFD/project-gcp-end2end",
    repoLabel: "View project-gcp-end2end on GitHub",
    logbookUrl: "/logbook",
    stack: [
      "Python 3.13 & Astral uv",
      "GCP Always Free Tier (us-central1)",
      "Cloud Storage & BigQuery ML",
      "scikit-learn / XGBoost",
      "FastAPI & Multi-Stage Docker",
      "Artifact Registry & Cloud Run",
      "Terraform IaC",
      "Keyless GitHub OIDC (WIF)",
    ],
    description:
      "Standalone, $0/month steady-state MLOps pipeline for imbalanced claims and financial transaction exception detection (3–4% base rate, evaluated on PR-AUC). Built local-first with a deterministic zero-PII synthetic QA generator, BigQuery ML baseline vs. custom model promotion gate, scale-to-zero Cloud Run canary serving, and automated PSI/KS feature-drift monitoring.",
    goals: [
      "Reinforce all 6 domains of the Google Cloud Professional Machine Learning Engineer exam (Target: December 2026) through hands-on architecture and IaC.",
      `Maintain canonical Specs (${gcpSpecCount} Core Specs), Architectural Decision Records (${gcpAdrCount} ADRs), and Operational Hurdles (${gcpHurdleCount} Hurdle) in project-gcp-end2end, mirrored one-way into vraidaten.com.`,
      "Enforce zero static cloud keys (keyless WIF), non-root slim containers, Trivy/Bandit/pip-audit CI gates, and hard billing guardrails before activating GCP trial credits.",
    ],
  },
];
---

<Layout title="Projects | Satyajit Chakraborty" description="Live and active practical projects in Cloud Engineering, Cloud ML, and MLOps.">
  <section class="py-6 md:py-10 space-y-10">
    <div class="space-y-3 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Practical Implementation &amp; Roadmap
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Live &amp; Active Projects
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        I focus on building and thoroughly documenting one practical project at a time—recording why each technology was selected, how it was implemented, what problems occurred, and how they were resolved.
      </p>
    </div>

    <div class="space-y-8">
      {projects.map((project) => (
        <article class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 sm:p-8 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 text-[11px] font-mono font-semibold text-brand-accent-light dark:text-brand-accent-dark">
              {project.status}
            </span>
            <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
              {project.timeline} · {project.role}
            </span>
          </div>

          <h2 class="text-xl font-bold text-brand-ink dark:text-brand-cream">
            {project.title}
          </h2>

          <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
            {project.description}
          </p>

          <div class="space-y-2">
            <h3 class="text-xs font-mono uppercase tracking-wider font-semibold text-brand-forest-light dark:text-brand-forest-dark">
              Key Learning &amp; Engineering Objectives
            </h3>
            <ul class="space-y-1.5 text-xs text-brand-ink-muted dark:text-brand-cream-muted list-disc pl-4">
              {project.goals.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-1">
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs font-semibold text-brand-accent-light dark:text-brand-accent-dark hover:underline"
            >
              {project.repoLabel} &rarr;
            </a>
            <a
              href={project.logbookUrl}
              class="font-mono text-xs font-semibold text-brand-forest-light dark:text-brand-forest-dark hover:underline"
            >
              Inspect Engineering Logbook &rarr;
            </a>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-brand-border/60 dark:border-brand-slate-border">
            {project.stack.map((tech) => (
              <span class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 text-[11px] font-mono text-brand-ink dark:text-brand-cream">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
