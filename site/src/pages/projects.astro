---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    title: "Current Project: VraiDaten Portfolio & Edge AI Assistant (vraidaten.com)",
    status: "Active Development & Live Deployment",
    timeline: "Current Priority",
    role: "Cloud Engineering & Edge AI Implementation",
    stack: [
      "Python 3.13",
      "Astral uv",
      "Pytest / Ruff / Mypy",
      "Astro 7",
      "Tailwind CSS v4",
      "Cloudflare Workers & Vectorize",
      "GitHub Actions CI/CD",
      "Linux libsecret Keyring",
    ],
    description:
      "My immediate practical priority is completing and documenting this portfolio website and grounded Edge AI assistant while strengthening my understanding of cloud deployment workflows. Implements a local Python Markdown ingestion pipeline, Cloudflare Vectorize (384-dim BGE embeddings), OS Keyring credential injection (zero plaintext .env files), automated code quality and security checks, and a compile-time synchronized Engineering Logbook.",
    goals: [
      "Practise end-to-end Git branching, pull request reviews, automated testing (pytest), and CI/CD deployment workflows.",
      "Document every architectural decision (ADRs 001–011) and operational troubleshooting hurdle (Hurdles 001–018) transparently in the Engineering Logbook.",
      "Operate reliably within $0/month free-tier cloud boundaries using lightweight edge inference (@cf/ibm-granite/granite-4.0-h-micro).",
    ],
  },
  {
    title: "Planned Project: Google Cloud End-to-End Implementation",
    status: "Planned (Commencing After Website Completion)",
    timeline: "Next Milestone",
    role: "Cloud Engineering & Cloud ML Practice",
    stack: [
      "Google Cloud Platform (GCP)",
      "Cloud IAM & Resource Management",
      "Python Automation",
      "Docker Containerization",
      "Cloud Monitoring & Logging",
      "ML Model Deployment & Serving",
    ],
    description:
      "After completing this website project, I intend to undertake an end-to-end Google Cloud project. The exact use case and architecture are currently being evaluated so that the project practically demonstrates cloud infrastructure management, application deployment, automation, monitoring, and troubleshooting—incorporating a machine learning component to connect my Data Science learning with my Cloud ML and MLOps interests.",
    goals: [
      "Reinforce concepts from my Google Cloud Professional Machine Learning Engineer study track (targeted for December 2026) through hands-on implementation.",
      "Practice cloud resource provisioning, least-privilege IAM, containerization, and operational observability.",
      "Update this page with concrete architecture diagrams, repository links, and troubleshooting logs as implementation progresses.",
    ],
  },
];
---

<Layout title="Projects | Satyajit Chakraborty" description="Current and planned practical projects in Cloud Engineering, Cloud ML, and MLOps.">
  <section class="py-6 md:py-10 space-y-10">
    <div class="space-y-3 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Practical Implementation &amp; Roadmap
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Current &amp; Planned Projects
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
        I focus on building and thoroughly documenting one practical project at a time—recording why each technology was selected, how it was implemented, what problems occurred, and how they were resolved.
      </p>
    </div>

    <div class="space-y-8">
      {projects.map((project) => (
        <article class="rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface p-6 sm:p-8 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 text-[11px] font-mono font-semibold text-brand-accent-light dark:text-brand-accent-dark">
              {project.status}
            </span>
            <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
              {project.timeline} · {project.role}
            </span>
          </div>

          <h2 class="text-xl font-bold text-brand-ink dark:text-brand-cream">
            {project.title}
          </h2>

          <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
            {project.description}
          </p>

          <div class="space-y-2">
            <h3 class="text-xs font-mono uppercase tracking-wider font-semibold text-brand-forest-light dark:text-brand-forest-dark">
              Key Learning &amp; Engineering Objectives
            </h3>
            <ul class="space-y-1.5 text-xs text-brand-ink-muted dark:text-brand-cream-muted list-disc pl-4">
              {project.goals.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-brand-border/60 dark:border-brand-slate-border">
            {project.stack.map((tech) => (
              <span class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 text-[11px] font-mono text-brand-ink dark:text-brand-cream">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
