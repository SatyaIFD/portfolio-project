---
import Layout from "../layouts/Layout.astro";
import MarkdownBlocks from "../components/MarkdownBlocks.astro";
import { parseMarkdown, type MarkdownBlock } from "../utils/markdown";

interface LogEntry {
  id: string;
  filename: string;
  title: string;
  blocks: MarkdownBlock[];
}

interface LogCategory {
  label: string;
  pathHint: string;
  entries: LogEntry[];
}

interface ProjectLogGroup {
  slug: string;
  name: string;
  subtitle: string;
  summary: string;
  status: string;
  coreDocs: LogEntry[];
  decisions: LogEntry[];
  hurdles: LogEntry[];
}

const PROJECT_META: Record<
  string,
  { name: string; subtitle: string; summary: string; status: string; order: number }
> = {
  "vraidaten-portfolio": {
    name: "VraiDaten Portfolio & Edge AI Assistant",
    subtitle: "Astro 7 · Cloudflare Workers · Vectorize · Python 3.13 RAG Pipeline",
    summary:
      "Serverless edge RAG portfolio operating within $0/month free-tier boundaries, with OS Keyring secret injection and automated CI security gates.",
    status: "Active · Live at vraidaten.com",
    order: 1,
  },
  "gcp-end-to-end": {
    name: "Google Cloud End-to-End MLOps: Claims QA Triage",
    subtitle: "GCP Always Free Tier (us-central1) · BigQuery ML · Docker · Cloud Run · Terraform",
    summary:
      "Cost-controlled ($0/month steady-state) imbalanced claims and transaction QA triage pipeline built local-first with zero real PII, keyless WIF CI/CD, and automated drift detection.",
    status: "Active · Phase 2 Complete",
    order: 2,
  },
};

const CORE_DOC_ORDER: Record<string, number> = {
  "architecture.md": 1,
  "requirements.md": 2,
  "security-and-threat-model.md": 3,
  "data-governance.md": 4,
  "runbook-and-finops.md": 5,
  "known-limitations.md": 6,
};

const rawCoreDocs = import.meta.glob<string>("../../../docs/projects/*/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

const rawDecisions = import.meta.glob<string>("../../../docs/projects/*/decisions/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

const rawHurdles = import.meta.glob<string>("../../../docs/projects/*/hurdles/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

function formatSlugTitle(slug: string): string {
  return slug
    .split("-")
    .map((part) => (part.length > 0 ? part[0].toUpperCase() + part.slice(1) : part))
    .join(" ");
}

function extractProjectSlug(filePath: string): string {
  const match = /\/docs\/projects\/([^/]+)\//.exec(filePath);
  return match?.[1] ?? "general";
}

function toLogEntry(filePath: string, rawContent: string): LogEntry {
  const filename = filePath.split("/").pop() ?? filePath;
  const raw = rawContent.trim();
  const lines = raw.split("\n");
  const firstLine = lines[0] ?? filename;
  const title = firstLine.replace(/^#+\s*/, "").trim();
  const body = lines.slice(1).join("\n").trim();
  return {
    id: filename.replace(/\.md$/, ""),
    filename,
    title,
    blocks: parseMarkdown(body),
  };
}

const projectMap = new Map<string, ProjectLogGroup>();

function ensureProject(slug: string): ProjectLogGroup {
  const existing = projectMap.get(slug);
  if (existing) {
    return existing;
  }
  const meta = PROJECT_META[slug];
  const created: ProjectLogGroup = {
    slug,
    name: meta?.name ?? formatSlugTitle(slug),
    subtitle: meta?.subtitle ?? `docs/projects/${slug}/`,
    summary: meta?.summary ?? "Project engineering specifications, architectural decisions, and troubleshooting logs.",
    status: meta?.status ?? "Documented",
    coreDocs: [],
    decisions: [],
    hurdles: [],
  };
  projectMap.set(slug, created);
  return created;
}

for (const [filePath, rawContent] of Object.entries(rawCoreDocs)) {
  ensureProject(extractProjectSlug(filePath)).coreDocs.push(toLogEntry(filePath, rawContent));
}
for (const [filePath, rawContent] of Object.entries(rawDecisions)) {
  ensureProject(extractProjectSlug(filePath)).decisions.push(toLogEntry(filePath, rawContent));
}
for (const [filePath, rawContent] of Object.entries(rawHurdles)) {
  ensureProject(extractProjectSlug(filePath)).hurdles.push(toLogEntry(filePath, rawContent));
}

const projects: ProjectLogGroup[] = Array.from(projectMap.values())
  .map((proj) => ({
    ...proj,
    coreDocs: proj.coreDocs.sort((a, b) => {
      const rankA = CORE_DOC_ORDER[a.filename] ?? 99;
      const rankB = CORE_DOC_ORDER[b.filename] ?? 99;
      return rankA !== rankB ? rankA - rankB : a.filename.localeCompare(b.filename);
    }),
    decisions: proj.decisions.sort((a, b) => a.filename.localeCompare(b.filename)),
    hurdles: proj.hurdles.sort((a, b) => a.filename.localeCompare(b.filename)),
  }))
  .sort((a, b) => {
    const orderA = PROJECT_META[a.slug]?.order ?? 99;
    const orderB = PROJECT_META[b.slug]?.order ?? 99;
    return orderA !== orderB ? orderA - orderB : a.slug.localeCompare(b.slug);
  });

const totalCoreDocs = projects.reduce((sum, p) => sum + p.coreDocs.length, 0);
const totalDecisions = projects.reduce((sum, p) => sum + p.decisions.length, 0);
const totalHurdles = projects.reduce((sum, p) => sum + p.hurdles.length, 0);

function getProjectCategories(proj: ProjectLogGroup): LogCategory[] {
  return [
    {
      label: "Core Specifications",
      pathHint: `docs/projects/${proj.slug}/*.md`,
      entries: proj.coreDocs,
    },
    {
      label: "Architectural Decision Records",
      pathHint: `docs/projects/${proj.slug}/decisions/*.md`,
      entries: proj.decisions,
    },
    {
      label: "Operational Hurdles & Root-Cause Logs",
      pathHint: `docs/projects/${proj.slug}/hurdles/*.md`,
      entries: proj.hurdles,
    },
  ].filter((cat) => cat.entries.length > 0);
}
---

<Layout description="Project-segregated Engineering Logbook with collapsible Core Specifications, ADRs, and Operational Hurdles." title="Engineering Logbook | Satyajit Chakraborty">
  <section class="py-6 md:py-10 space-y-8">
    <div class="space-y-3">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Project-Segregated Single Source of Truth · Compiled from docs/projects/
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Engineering Logbook
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        Select a project below to expand its documentation sections (<strong class="font-semibold text-brand-ink dark:text-brand-cream">{totalCoreDocs} Core Specs</strong>, <strong class="font-semibold text-brand-ink dark:text-brand-cream">{totalDecisions} ADRs</strong>, and <strong class="font-semibold text-brand-ink dark:text-brand-cream">{totalHurdles} Hurdles</strong> across {projects.length} {projects.length === 1 ? "project" : "projects"}). Every file is compiled directly from <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">docs/projects/</code> and synchronized with <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">vraidaten-index</code>.
      </p>
    </div>

    <!-- Level 1: Collapsible Project Cards (All Collapsed by Default) -->
    <div class="space-y-4">
      {projects.map((proj) => {
        const categories = getProjectCategories(proj);
        return (
          <details
            id={`project-${proj.slug}`}
            class="group/project scroll-mt-24 rounded-xl border-2 border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface overflow-hidden transition-colors"
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 sm:p-6 hover:bg-brand-recessed/40 dark:hover:bg-brand-slate-recessed/40 transition-colors">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-[11px] uppercase tracking-wider font-semibold text-brand-forest-light dark:text-brand-forest-dark">
                    {proj.status}
                  </span>
                  <span class="rounded border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-2 py-0.5 font-mono text-[10px] text-brand-ink-muted dark:text-brand-cream-muted">
                    docs/projects/{proj.slug}/
                  </span>
                </div>

                <h2 class="text-lg sm:text-xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
                  {proj.name}
                </h2>

                <p class="font-mono text-xs text-brand-accent-light dark:text-brand-accent-dark">
                  {proj.subtitle}
                </p>

                <p class="text-xs text-brand-ink-muted dark:text-brand-cream-muted max-w-2xl leading-relaxed">
                  {proj.summary}
                </p>

                <div class="flex flex-wrap gap-2 pt-1 font-mono text-[11px] text-brand-ink dark:text-brand-cream">
                  <span class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-2 py-0.5">
                    {proj.coreDocs.length} Core Specs
                  </span>
                  <span class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-2 py-0.5">
                    {proj.decisions.length} ADRs
                  </span>
                  <span class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-2 py-0.5">
                    {proj.hurdles.length} Hurdles
                  </span>
                </div>
              </div>

              <span
                aria-hidden="true"
                class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed font-mono text-lg font-semibold text-brand-accent-light dark:text-brand-accent-dark transition-transform duration-200 group-open/project:rotate-45"
              >
                +
              </span>
            </summary>

            <!-- Level 2: Collapsible Category Sections inside Project -->
            <div class="border-t border-brand-border dark:border-brand-slate-border bg-brand-paper/50 dark:bg-brand-slate/50 p-4 sm:p-5 space-y-3">
              {categories.map((cat) => (
                <details class="group/category rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface overflow-hidden">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3.5 hover:bg-brand-recessed/40 dark:hover:bg-brand-slate-recessed/40 transition-colors">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                      <h3 class="text-sm sm:text-base font-bold text-brand-ink dark:text-brand-cream">
                        {cat.label} ({cat.entries.length})
                      </h3>
                      <span class="font-mono text-[11px] text-brand-ink-muted dark:text-brand-cream-muted">
                        {cat.pathHint}
                      </span>
                    </div>
                    <span
                      aria-hidden="true"
                      class="flex h-6 w-6 shrink-0 items-center justify-center rounded border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed font-mono text-sm font-semibold text-brand-accent-light dark:text-brand-accent-dark transition-transform duration-200 group-open/category:rotate-45"
                    >
                      +
                    </span>
                  </summary>

                  <!-- Level 3: Collapsible Individual Markdown Files -->
                  <div class="border-t border-brand-border/70 dark:border-brand-slate-border bg-brand-paper/40 dark:bg-brand-slate/40 p-3 space-y-2">
                    {cat.entries.map((entry) => (
                      <details class="group/doc rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-4 py-3">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-xs sm:text-sm text-brand-ink dark:text-brand-cream">
                          <span>{entry.title}</span>
                          <span
                            aria-hidden="true"
                            class="shrink-0 font-mono text-sm text-brand-accent-light dark:text-brand-accent-dark transition-transform duration-200 group-open/doc:rotate-45"
                          >
                            +
                          </span>
                        </summary>
                        <MarkdownBlocks blocks={entry.blocks} />
                      </details>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
        );
      })}
    </div>
  </section>
</Layout>
