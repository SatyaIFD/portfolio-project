---
import Layout from "../layouts/Layout.astro";
import { parseMarkdown, type MarkdownBlock, type InlineToken } from "../utils/markdown";

interface LogEntry {
  id: string;
  title: string;
  blocks: MarkdownBlock[];
}

const rawDecisions = import.meta.glob<string>("../../../docs/decisions/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

const rawHurdles = import.meta.glob<string>("../../../docs/hurdles/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

function parseGlobEntries(globMap: Record<string, string>): LogEntry[] {
  return Object.entries(globMap)
    .sort(([pathA], [pathB]) => pathA.localeCompare(pathB))
    .map(([filePath, rawContent]) => {
      const filename = filePath.split("/").pop() ?? filePath;
      const raw = rawContent.trim();
      const lines = raw.split("\n");
      const firstLine = lines[0] ?? filename;
      const title = firstLine.replace(/^#+\s*/, "").trim();
      const body = lines.slice(1).join("\n").trim();
      return {
        id: filename.replace(/\.md$/, ""),
        title,
        blocks: parseMarkdown(body),
      };
    });
}

const decisions = parseGlobEntries(rawDecisions);
const hurdles = parseGlobEntries(rawHurdles);
---

<Layout description="Architectural Decision Records (ADRs) and operational troubleshooting logs compiled from docs/." title="Engineering Logbook | Satyajit Chakraborty">
  <section class="py-6 md:py-10 space-y-12">
    <div class="space-y-3">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Single Source of Truth · Compiled from docs/ via Vite
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Engineering Logbook
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        Every entry below is parsed and rendered directly from the repository&apos;s <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">docs/decisions/</code> ({decisions.length} ADRs) and <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">docs/hurdles/</code> ({hurdles.length} Hurdles) Markdown files—the exact same files embedded into Cloudflare Vectorize (<code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">vraidaten-index</code>).
      </p>
    </div>

    <!-- Architectural Decision Records (ADRs) -->
    <div class="space-y-5">
      <div class="border-b border-brand-border dark:border-brand-slate-border pb-3 flex items-baseline justify-between">
        <h2 class="text-xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
          Architectural Decision Records ({decisions.length})
        </h2>
        <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">docs/decisions/*.md</span>
      </div>

      <div class="space-y-3">
        {decisions.map((adr, index) => (
          <details
            open={index < 2}
            class="group rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-5 py-4 transition-colors"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-sm text-brand-ink dark:text-brand-cream">
              <span>{adr.title}</span>
              <span class="font-mono text-sm text-brand-accent-light dark:text-brand-accent-dark group-open:rotate-45 transition-transform">
                +
              </span>
            </summary>

            <div class="mt-4 space-y-3 border-t border-brand-border/60 dark:border-brand-slate-border pt-4 text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
              {adr.blocks.map((block) => (
                block.type === "heading" ? (
                  <h3 class="font-semibold text-brand-ink dark:text-brand-cream pt-1">
                    {block.tokens.map((tok: InlineToken) => (
                      tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                      tok.type === "italic" ? <em class="italic">{tok.value}</em> :
                      tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                      tok.value
                    ))}
                  </h3>
                ) : block.type === "codeblock" ? (
                  <pre class="overflow-x-auto rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed p-3 font-mono text-[11px] text-brand-ink dark:text-brand-cream">{block.content}</pre>
                ) : block.type === "list" ? (
                  block.ordered ? (
                    <ol class="list-decimal space-y-1.5 pl-5">
                      {block.items.map((item) => (
                        <li class={item.indent > 0 ? "ml-5 list-[lower-alpha]" : ""}>
                          {item.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <ul class="list-disc space-y-1.5 pl-5">
                      {block.items.map((item) => (
                        <li class={item.indent > 0 ? "ml-5 list-[circle]" : ""}>
                          {item.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </li>
                      ))}
                    </ul>
                  )
                ) : (
                  <p>
                    {block.tokens.map((tok: InlineToken) => (
                      tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                      tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                      tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                      tok.value
                    ))}
                  </p>
                )
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Operational Hurdles & Post-Mortems -->
    <div class="space-y-5">
      <div class="border-b border-brand-border dark:border-brand-slate-border pb-3 flex items-baseline justify-between">
        <h2 class="text-xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
          Operational Hurdles &amp; Root-Cause Logs ({hurdles.length})
        </h2>
        <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">docs/hurdles/*.md</span>
      </div>

      <div class="space-y-3">
        {hurdles.map((hurdle, index) => (
          <details
            open={index === hurdles.length - 1}
            class="group rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-5 py-4 transition-colors"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-sm text-brand-ink dark:text-brand-cream">
              <span>{hurdle.title}</span>
              <span class="font-mono text-sm text-brand-accent-light dark:text-brand-accent-dark group-open:rotate-45 transition-transform">
                +
              </span>
            </summary>

            <div class="mt-4 space-y-3 border-t border-brand-border/60 dark:border-brand-slate-border pt-4 text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
              {hurdle.blocks.map((block) => (
                block.type === "heading" ? (
                  <h3 class="font-semibold text-brand-ink dark:text-brand-cream pt-1">
                    {block.tokens.map((tok: InlineToken) => (
                      tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                      tok.type === "italic" ? <em class="italic">{tok.value}</em> :
                      tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                      tok.value
                    ))}
                  </h3>
                ) : block.type === "codeblock" ? (
                  <pre class="overflow-x-auto rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed p-3 font-mono text-[11px] text-brand-ink dark:text-brand-cream">{block.content}</pre>
                ) : block.type === "list" ? (
                  block.ordered ? (
                    <ol class="list-decimal space-y-1.5 pl-5">
                      {block.items.map((item) => (
                        <li class={item.indent > 0 ? "ml-5 list-[lower-alpha]" : ""}>
                          {item.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <ul class="list-disc space-y-1.5 pl-5">
                      {block.items.map((item) => (
                        <li class={item.indent > 0 ? "ml-5 list-[circle]" : ""}>
                          {item.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </li>
                      ))}
                    </ul>
                  )
                ) : (
                  <p>
                    {block.tokens.map((tok: InlineToken) => (
                      tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                      tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                      tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                      tok.value
                    ))}
                  </p>
                )
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
