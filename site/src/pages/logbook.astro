---
import Layout from "../layouts/Layout.astro";
import {
  parseMarkdown,
  type MarkdownBlock,
  type InlineToken,
  type ListItem,
} from "../utils/markdown";

interface LogEntry {
  id: string;
  filename: string;
  title: string;
  blocks: MarkdownBlock[];
}

interface ProjectLogGroup {
  slug: string;
  name: string;
  subtitle: string;
  status: string;
  coreDocs: LogEntry[];
  decisions: LogEntry[];
  hurdles: LogEntry[];
}

const PROJECT_META: Record<string, { name: string; subtitle: string; status: string; order: number }> = {
  "vraidaten-portfolio": {
    name: "VraiDaten Portfolio & Edge AI Assistant",
    subtitle: "Astro 7 · Cloudflare Workers · Vectorize · Python 3.13 RAG Pipeline",
    status: "Active · Live at vraidaten.com",
    order: 1,
  },
  "gcp-end-to-end": {
    name: "Google Cloud End-to-End Implementation",
    subtitle: "Google Cloud Platform · IAM · Containerization · Cloud ML",
    status: "Planned",
    order: 2,
  },
};

const CORE_DOC_ORDER: Record<string, number> = {
  "architecture.md": 1,
  "requirements.md": 2,
  "known-limitations.md": 3,
};

const rawCoreDocs = import.meta.glob<string>("../../../docs/projects/*/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

const rawDecisions = import.meta.glob<string>("../../../docs/projects/*/decisions/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

const rawHurdles = import.meta.glob<string>("../../../docs/projects/*/hurdles/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

function formatSlugTitle(slug: string): string {
  return slug
    .split("-")
    .map((part) => (part.length > 0 ? part[0].toUpperCase() + part.slice(1) : part))
    .join(" ");
}

function extractProjectSlug(filePath: string): string {
  const match = /\/docs\/projects\/([^/]+)\//.exec(filePath);
  return match?.[1] ?? "general";
}

function toLogEntry(filePath: string, rawContent: string): LogEntry {
  const filename = filePath.split("/").pop() ?? filePath;
  const raw = rawContent.trim();
  const lines = raw.split("\n");
  const firstLine = lines[0] ?? filename;
  const title = firstLine.replace(/^#+\s*/, "").trim();
  const body = lines.slice(1).join("\n").trim();
  return {
    id: filename.replace(/\.md$/, ""),
    filename,
    title,
    blocks: parseMarkdown(body),
  };
}

const projectMap = new Map<string, ProjectLogGroup>();

function ensureProject(slug: string): ProjectLogGroup {
  const existing = projectMap.get(slug);
  if (existing) {
    return existing;
  }
  const meta = PROJECT_META[slug];
  const created: ProjectLogGroup = {
    slug,
    name: meta?.name ?? formatSlugTitle(slug),
    subtitle: meta?.subtitle ?? `docs/projects/${slug}/`,
    status: meta?.status ?? "Documented",
    coreDocs: [],
    decisions: [],
    hurdles: [],
  };
  projectMap.set(slug, created);
  return created;
}

for (const [filePath, rawContent] of Object.entries(rawCoreDocs)) {
  ensureProject(extractProjectSlug(filePath)).coreDocs.push(toLogEntry(filePath, rawContent));
}
for (const [filePath, rawContent] of Object.entries(rawDecisions)) {
  ensureProject(extractProjectSlug(filePath)).decisions.push(toLogEntry(filePath, rawContent));
}
for (const [filePath, rawContent] of Object.entries(rawHurdles)) {
  ensureProject(extractProjectSlug(filePath)).hurdles.push(toLogEntry(filePath, rawContent));
}

const projects: ProjectLogGroup[] = Array.from(projectMap.values())
  .map((proj) => ({
    ...proj,
    coreDocs: proj.coreDocs.sort((a, b) => {
      const rankA = CORE_DOC_ORDER[a.filename] ?? 99;
      const rankB = CORE_DOC_ORDER[b.filename] ?? 99;
      return rankA !== rankB ? rankA - rankB : a.filename.localeCompare(b.filename);
    }),
    decisions: proj.decisions.sort((a, b) => a.filename.localeCompare(b.filename)),
    hurdles: proj.hurdles.sort((a, b) => a.filename.localeCompare(b.filename)),
  }))
  .sort((a, b) => {
    const orderA = PROJECT_META[a.slug]?.order ?? 99;
    const orderB = PROJECT_META[b.slug]?.order ?? 99;
    return orderA !== orderB ? orderA - orderB : a.slug.localeCompare(b.slug);
  });

const totalCoreDocs = projects.reduce((sum, p) => sum + p.coreDocs.length, 0);
const totalDecisions = projects.reduce((sum, p) => sum + p.decisions.length, 0);
const totalHurdles = projects.reduce((sum, p) => sum + p.hurdles.length, 0);
---

<Layout
  description="Project-segregated Core Specifications, Architectural Decision Records (ADRs), and Operational Hurdles compiled from docs/projects/."
  title="Engineering Logbook | Satyajit Chakraborty"
>
  <section class="py-6 md:py-10 space-y-12">
    <div class="space-y-4">
      <p class="font-mono text-xs uppercase tracking-wider text-brand-accent-light dark:text-brand-accent-dark">
        Project-Segregated Single Source of Truth · Compiled from docs/projects/
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
        Engineering Logbook
      </h1>
      <p class="text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted max-w-3xl leading-relaxed">
        Documentation is segregated by project under <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">docs/projects/&lt;project&gt;/</code> so upcoming cloud and MLOps builds remain cleanly separated. Currently indexing <strong class="font-semibold text-brand-ink dark:text-brand-cream">{totalCoreDocs} Core Specs</strong>, <strong class="font-semibold text-brand-ink dark:text-brand-cream">{totalDecisions} ADRs</strong>, and <strong class="font-semibold text-brand-ink dark:text-brand-cream">{totalHurdles} Hurdles</strong> across {projects.length} {projects.length === 1 ? "project" : "projects"}—the exact same Markdown files embedded into <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-ink dark:text-brand-cream">vraidaten-index</code>.
      </p>

      <!-- Project Jump Navigation -->
      <div class="flex flex-wrap gap-2 pt-1">
        {projects.map((proj) => (
          <a
            href={`#project-${proj.slug}`}
            class="inline-flex items-center gap-2 rounded-md border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-3 py-1.5 text-xs font-mono text-brand-ink dark:text-brand-cream hover:border-brand-accent-light dark:hover:border-brand-accent-dark transition-colors"
          >
            <span class="font-semibold text-brand-accent-light dark:text-brand-accent-dark">{proj.name}</span>
            <span class="text-[10px] text-brand-ink-muted dark:text-brand-cream-muted">
              ({proj.coreDocs.length} Specs · {proj.decisions.length} ADRs · {proj.hurdles.length} Hurdles)
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Project Sections -->
    {projects.map((proj) => (
      <div id={`project-${proj.slug}`} class="scroll-mt-24 space-y-10 border-t-2 border-brand-border dark:border-brand-slate-border pt-8">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div class="space-y-1">
            <span class="font-mono text-[11px] uppercase tracking-wider font-semibold text-brand-forest-light dark:text-brand-forest-dark">
              Project · {proj.status}
            </span>
            <h2 class="text-2xl font-bold tracking-tight text-brand-ink dark:text-brand-cream">
              {proj.name}
            </h2>
            <p class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
              {proj.subtitle}
            </p>
          </div>
          <span class="rounded border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed px-2.5 py-1 font-mono text-[11px] text-brand-ink-muted dark:text-brand-cream-muted">
            docs/projects/{proj.slug}/
          </span>
        </div>

        <!-- 1. Core Specifications -->
        {proj.coreDocs.length > 0 && (
          <div class="space-y-4">
            <div class="border-b border-brand-border dark:border-brand-slate-border pb-2.5 flex items-baseline justify-between">
              <h3 class="text-lg font-bold tracking-tight text-brand-ink dark:text-brand-cream">
                Core Specifications ({proj.coreDocs.length})
              </h3>
              <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
                docs/projects/{proj.slug}/*.md
              </span>
            </div>

            <div class="space-y-3">
              {proj.coreDocs.map((doc) => (
                <details class="group rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-5 py-4 transition-colors">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-sm text-brand-ink dark:text-brand-cream">
                    <span>{doc.title}</span>
                    <span class="font-mono text-sm text-brand-accent-light dark:text-brand-accent-dark group-open:rotate-45 transition-transform">+</span>
                  </summary>
                  <div class="mt-4 space-y-3 border-t border-brand-border/60 dark:border-brand-slate-border pt-4 text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
                    {doc.blocks.map((block: MarkdownBlock) => (
                      block.type === "heading" ? (
                        <h4 class="font-semibold text-brand-ink dark:text-brand-cream pt-1">
                          {block.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </h4>
                      ) : block.type === "codeblock" ? (
                        <pre class="overflow-x-auto rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed p-3 font-mono text-[11px] text-brand-ink dark:text-brand-cream">{block.content}</pre>
                      ) : block.type === "list" ? (
                        block.ordered ? (
                          <ol class="list-decimal space-y-1.5 pl-5">
                            {block.items.map((item: ListItem) => (
                              <li class={item.indent > 0 ? "ml-5 list-[lower-alpha]" : ""}>
                                {item.tokens.map((tok: InlineToken) => (
                                  tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                                  tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                                  tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                                  tok.value
                                ))}
                              </li>
                            ))}
                          </ol>
                        ) : (
                          <ul class="list-disc space-y-1.5 pl-5">
                            {block.items.map((item: ListItem) => (
                              <li class={item.indent > 0 ? "ml-5 list-[circle]" : ""}>
                                {item.tokens.map((tok: InlineToken) => (
                                  tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                                  tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                                  tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                                  tok.value
                                ))}
                              </li>
                            ))}
                          </ul>
                        )
                      ) : (
                        <p>
                          {block.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </p>
                      )
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- 2. Architectural Decision Records -->
        {proj.decisions.length > 0 && (
          <div class="space-y-4">
            <div class="border-b border-brand-border dark:border-brand-slate-border pb-2.5 flex items-baseline justify-between">
              <h3 class="text-lg font-bold tracking-tight text-brand-ink dark:text-brand-cream">
                Architectural Decision Records ({proj.decisions.length})
              </h3>
              <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
                docs/projects/{proj.slug}/decisions/*.md
              </span>
            </div>

            <div class="space-y-3">
              {proj.decisions.map((adr, index) => (
                <details
                  open={index < 2}
                  class="group rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-5 py-4 transition-colors"
                >
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-sm text-brand-ink dark:text-brand-cream">
                    <span>{adr.title}</span>
                    <span class="font-mono text-sm text-brand-accent-light dark:text-brand-accent-dark group-open:rotate-45 transition-transform">+</span>
                  </summary>
                  <div class="mt-4 space-y-3 border-t border-brand-border/60 dark:border-brand-slate-border pt-4 text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
                    {adr.blocks.map((block: MarkdownBlock) => (
                      block.type === "heading" ? (
                        <h4 class="font-semibold text-brand-ink dark:text-brand-cream pt-1">
                          {block.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </h4>
                      ) : block.type === "codeblock" ? (
                        <pre class="overflow-x-auto rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed p-3 font-mono text-[11px] text-brand-ink dark:text-brand-cream">{block.content}</pre>
                      ) : block.type === "list" ? (
                        block.ordered ? (
                          <ol class="list-decimal space-y-1.5 pl-5">
                            {block.items.map((item: ListItem) => (
                              <li class={item.indent > 0 ? "ml-5 list-[lower-alpha]" : ""}>
                                {item.tokens.map((tok: InlineToken) => (
                                  tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                                  tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                                  tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                                  tok.value
                                ))}
                              </li>
                            ))}
                          </ol>
                        ) : (
                          <ul class="list-disc space-y-1.5 pl-5">
                            {block.items.map((item: ListItem) => (
                              <li class={item.indent > 0 ? "ml-5 list-[circle]" : ""}>
                                {item.tokens.map((tok: InlineToken) => (
                                  tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                                  tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                                  tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                                  tok.value
                                ))}
                              </li>
                            ))}
                          </ul>
                        )
                      ) : (
                        <p>
                          {block.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </p>
                      )
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- 3. Operational Hurdles & Post-Mortems -->
        {proj.hurdles.length > 0 && (
          <div class="space-y-4">
            <div class="border-b border-brand-border dark:border-brand-slate-border pb-2.5 flex items-baseline justify-between">
              <h3 class="text-lg font-bold tracking-tight text-brand-ink dark:text-brand-cream">
                Operational Hurdles &amp; Root-Cause Logs ({proj.hurdles.length})
              </h3>
              <span class="font-mono text-xs text-brand-ink-muted dark:text-brand-cream-muted">
                docs/projects/{proj.slug}/hurdles/*.md
              </span>
            </div>

            <div class="space-y-3">
              {proj.hurdles.map((hurdle, index) => (
                <details
                  open={index === proj.hurdles.length - 1}
                  class="group rounded-xl border border-brand-border dark:border-brand-slate-border bg-brand-surface dark:bg-brand-slate-surface px-5 py-4 transition-colors"
                >
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-sm text-brand-ink dark:text-brand-cream">
                    <span>{hurdle.title}</span>
                    <span class="font-mono text-sm text-brand-accent-light dark:text-brand-accent-dark group-open:rotate-45 transition-transform">+</span>
                  </summary>
                  <div class="mt-4 space-y-3 border-t border-brand-border/60 dark:border-brand-slate-border pt-4 text-xs sm:text-sm text-brand-ink-muted dark:text-brand-cream-muted leading-relaxed">
                    {hurdle.blocks.map((block: MarkdownBlock) => (
                      block.type === "heading" ? (
                        <h4 class="font-semibold text-brand-ink dark:text-brand-cream pt-1">
                          {block.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </h4>
                      ) : block.type === "codeblock" ? (
                        <pre class="overflow-x-auto rounded-lg border border-brand-border dark:border-brand-slate-border bg-brand-recessed dark:bg-brand-slate-recessed p-3 font-mono text-[11px] text-brand-ink dark:text-brand-cream">{block.content}</pre>
                      ) : block.type === "list" ? (
                        block.ordered ? (
                          <ol class="list-decimal space-y-1.5 pl-5">
                            {block.items.map((item: ListItem) => (
                              <li class={item.indent > 0 ? "ml-5 list-[lower-alpha]" : ""}>
                                {item.tokens.map((tok: InlineToken) => (
                                  tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                                  tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                                  tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                                  tok.value
                                ))}
                              </li>
                            ))}
                          </ol>
                        ) : (
                          <ul class="list-disc space-y-1.5 pl-5">
                            {block.items.map((item: ListItem) => (
                              <li class={item.indent > 0 ? "ml-5 list-[circle]" : ""}>
                                {item.tokens.map((tok: InlineToken) => (
                                  tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                                  tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                                  tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                                  tok.value
                                ))}
                              </li>
                            ))}
                          </ul>
                        )
                      ) : (
                        <p>
                          {block.tokens.map((tok: InlineToken) => (
                            tok.type === "bold" ? <strong class="font-semibold text-brand-ink dark:text-brand-cream">{tok.value}</strong> :
                            tok.type === "italic" ? <em class="italic text-brand-ink dark:text-brand-cream">{tok.value}</em> :
                            tok.type === "code" ? <code class="rounded bg-brand-recessed dark:bg-brand-slate-recessed px-1.5 py-0.5 font-mono text-[11px] text-brand-accent-light dark:text-brand-accent-dark">{tok.value}</code> :
                            tok.value
                          ))}
                        </p>
                      )
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    ))}
  </section>
</Layout>
