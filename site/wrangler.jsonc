{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vraidaten-portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "vraidaten-index",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "MODEL_ID": "@cf/ibm-granite/granite-4.0-h-micro",
    "FALLBACK_MODEL_ID": "@cf/google/gemma-4-26b-a4b-it",
    "EMBEDDING_MODEL_ID": "@cf/baai/bge-small-en-v1.5",
    "SIMILARITY_THRESHOLD": "0.60",
    "MAX_PROMPT_LENGTH": "500",
    "MAX_OUTPUT_TOKENS": "256",
    "VECTOR_TOP_K": "3",
    "ALLOWED_ORIGIN": "https://vraidaten.com"
  }
}
